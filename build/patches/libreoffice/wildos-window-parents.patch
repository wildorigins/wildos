+namespace
+{
+// Wild OS: these dialogs come up before any document window, so they had
+// LibreOffice's own icon and, on Wayland, its app_id: a plain taskbar button
+// of their own. Give them the icon of the app whose documents they save or
+// recover (Writer's when none is known), which also puts them on that app's
+// taskbar button.
+void lcl_wildosAppIcon(weld::Dialog& rDialog, const TURLList& rURLs)
+{
+    SvtModuleOptions::EFactory eFactory = SvtModuleOptions::EFactory::WRITER;
+    for (const TURLInfo& rInfo : rURLs)
+    {
+        const SvtModuleOptions::EFactory eDoc
+            = SvtModuleOptions::ClassifyFactoryByServiceName(rInfo.Module);
+        if (eDoc != SvtModuleOptions::EFactory::UNKNOWN_FACTORY)
+        {
+            eFactory = eDoc;
+            break;
+        }
+    }
+    VclPtr<vcl::Window> pWindow = VCLUnoHelper::GetWindow(rDialog.GetXWindow());
+    if (pWindow && pWindow->IsSystemWindow())
+        static_cast<SystemWindow*>(pWindow.get())
+            ->SetIcon(static_cast<sal_uInt16>(SvtModuleOptions().GetFactoryIcon(eFactory)));
+}
+}

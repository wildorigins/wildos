+namespace
+{
+// The window a file dialog belongs to: the one LibreOffice named, else the
+// active one.
+QWidget* lcl_transientParent(QWidget* pParentWidget)
+{
+    if (pParentWidget)
+        return pParentWidget;
+    vcl::Window* pWindow = ::Application::GetActiveTopWindow();
+    if (!pWindow)
+        return nullptr;
+    QtFrame* pFrame = dynamic_cast<QtFrame*>(pWindow->ImplGetFrame());
+    assert(pFrame);
+    return pFrame ? pFrame->asChild() : nullptr;
+}
+
+// Wild OS: the portal's name for the window a dialog belongs to ("wayland:"
+// and an xdg-foreign handle, or "x11:" and its id), so the dialog opens
+// attached to it, in front of it and without a taskbar button of its own.
+// On Wayland the window LibreOffice names can be a hidden one (window ids
+// mean nothing there), so then the active window. Empty without either.
+QString lcl_portalParent(QWidget* pParent)
+{
+#ifdef WILDOS_QT_PRIVATE
+    auto aShown = [](QWidget* pWidget) -> QWindow* {
+        QWindow* pWindow = pWidget ? pWidget->window()->windowHandle() : nullptr;
+        return pWindow && pWindow->isVisible() ? pWindow : nullptr;
+    };
+    QWindow* pWindow = aShown(pParent);
+    if (!pWindow)
+        pWindow = aShown(lcl_transientParent(nullptr));
+    auto pServices = dynamic_cast<QGenericUnixServices*>(
+        QGuiApplicationPrivate::platformIntegration()->services());
+    return pWindow && pServices ? pServices->portalWindowIdentifier(pWindow) : QString();
+#else
+    (void)pParent;
+    return QString();
+#endif
+}
+}

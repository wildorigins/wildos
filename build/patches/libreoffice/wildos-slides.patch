+// Wild OS: a filled box with rounded corners, for the pill buttons.
+static void PaintRoundedBox (
+    const Reference<rendering::XCanvas>& rxCanvas,
+    const rendering::ViewState& rViewState,
+    const awt::Rectangle& rBox,
+    const double nRadius,
+    const util::Color nColor)
+{
+    Reference<rendering::XGraphicDevice> xDevice (rxCanvas->getDevice());
+    if (!xDevice.is())
+        return;
+    const double nX1 (rBox.X), nY1 (rBox.Y), nX2 (rBox.X + rBox.Width), nY2 (rBox.Y + rBox.Height);
+    const double nR (nRadius), nK (nRadius * 0.4477);
+    // Each segment starts at its point; the two control points lead to the
+    // next segment's point. Edges are straight, corners quarter circles.
+    Sequence<Sequence<geometry::RealBezierSegment2D>> aPolygon
+    {
+        {
+            { nX1+nR, nY1, nX1+nR, nY1, nX2-nR, nY1 },
+            { nX2-nR, nY1, nX2-nK, nY1, nX2, nY1+nK },
+            { nX2, nY1+nR, nX2, nY1+nR, nX2, nY2-nR },
+            { nX2, nY2-nR, nX2, nY2-nK, nX2-nK, nY2 },
+            { nX2-nR, nY2, nX2-nR, nY2, nX1+nR, nY2 },

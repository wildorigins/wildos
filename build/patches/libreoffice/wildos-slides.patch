+UsePenCommand::UsePenCommand (
+    const bool bUsePen,
+    rtl::Reference<PresenterController> xPresenterController)
+: mbUsePen(bUsePen),
+  mpPresenterController(std::move(xPresenterController))
+{
+}
+
+void UsePenCommand::Execute()
+{
+    if ( ! mpPresenterController.is())
+        return;
+
+    Reference<presentation::XSlideShowController> xController (
+        mpPresenterController->GetSlideShowController());
+    if (xController.is())
+        xController->setUsePen(mbUsePen);
+    if (mpPresenterController->GetWindowManager().is())
+        mpPresenterController->GetWindowManager()->NotifyStateChange();
+}
+
+Any UsePenCommand::GetState() const
+{
+    if ( ! mpPresenterController.is())
+        return Any(false);
+
+    Reference<presentation::XSlideShowController> xController (
+        mpPresenterController->GetSlideShowController());
+    return Any(xController.is() && bool(xController->getUsePen()) == mbUsePen);
+}
+
+BlackScreenCommand::BlackScreenCommand (rtl::Reference<PresenterController> xPresenterController)
+: mpPresenterController(std::move(xPresenterController))
+{
+}
+
+void BlackScreenCommand::Execute()
+{
+    if ( ! mpPresenterController.is())
+        return;
+
+    Reference<presentation::XSlideShowController> xController (
+        mpPresenterController->GetSlideShowController());
+    if (xController.is())
+    {
+        if (xController->isPaused())
+            xController->resume();
+        else
+            xController->blankScreen(0x00000000);
+    }
+    if (mpPresenterController->GetWindowManager().is())
+        mpPresenterController->GetWindowManager()->NotifyStateChange();
+}
+
+Any BlackScreenCommand::GetState() const
+{
+    if ( ! mpPresenterController.is())
+        return Any(false);
+
+    Reference<presentation::XSlideShowController> xController (
+        mpPresenterController->GetSlideShowController());
+    return Any(xController.is() && xController->isPaused());
+}

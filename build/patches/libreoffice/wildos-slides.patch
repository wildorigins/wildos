+bool PresenterWindowManager::IsWildOSLayout()
+{
+    return mpPaneContainer.is()
+        && mpPaneContainer->FindViewURL(PresenterViewFactory::msTopBarViewURL) != nullptr;
+}
+
+// Wild OS: the Slides presenter view (board 12.20). A top bar with the file
+// name, slide count, timer and clock; the slide on screen large on the left;
+// the next slide and the notes on the right; and along the bottom the
+// buttons, a strip of slide thumbnails and End show. The board is 1440 by
+// 900 and its measures are used as they are.
+void PresenterWindowManager::LayoutWildOSMode()
+{
+    const awt::Rectangle aBox = mxParentWindow->getPosSize();
+    const double nMargin (32);
+    const double nGap (36);
+    const double nTopBar (64);
+    const double nBottomBar (96);
+    const double nPadding (26);
+
+    // A bar's own width: its buttons and labels, with its pane's border.
+    auto aBarWidth = [this] (const OUString& rsViewURL) -> double
+    {
+        PresenterPaneContainer::SharedPaneDescriptor pDescriptor (mpPaneContainer->FindViewURL(rsViewURL));
+        if (!pDescriptor)
+            return 0;
+        PresenterToolBarView* pView = dynamic_cast<PresenterToolBarView*>(pDescriptor->mxView.get());
+        if (pView == nullptr || !pView->GetPresenterToolBar().is())
+            return 0;
+        return pView->GetPresenterToolBar()->GetMinimalSize().Width;
+    };
+    auto aPlace = [this] (const OUString& rsViewURL, double nX, double nY, double nWidth, double nHeight)
+    {
+        const OUString sPaneURL (mpPaneContainer->GetPaneURLForViewURL(rsViewURL));
+        if (!sPaneURL.isEmpty() && nWidth > 0 && nHeight > 0)
+            SetPanePosSizeAbsolute(sPaneURL, nX, nY, nWidth, nHeight);
+    };
+
+    // The top bar: file name and slide count from the left, timer and clock
+    // to the right.
+    aPlace(PresenterViewFactory::msTopBarViewURL, nMargin, 0, aBox.Width * 0.55, nTopBar);
+    aPlace(PresenterViewFactory::msTimeBarViewURL,
+        aBox.Width - nMargin - aBox.Width * 0.3, 0, aBox.Width * 0.3, nTopBar);
+
+    // The bottom bar: the buttons, then the thumbnails up to End show.
+    const double nBottomY (aBox.Height - nBottomBar);
+    const double nToolBarWidth (aBarWidth(PresenterViewFactory::msToolBarViewURL));
+    const double nEndBarWidth (aBarWidth(PresenterViewFactory::msEndBarViewURL));
+    // (A pixel down, clear of the hairline over the bar.)
+    aPlace(PresenterViewFactory::msToolBarViewURL, nMargin, nBottomY + 1, nToolBarWidth, nBottomBar - 1);
+    aPlace(PresenterViewFactory::msEndBarViewURL,
+        aBox.Width - nMargin - nEndBarWidth, nBottomY + 1, nEndBarWidth, nBottomBar - 1);
+    const double nStripX (nMargin + nToolBarWidth + nGap);
+    aPlace(PresenterViewFactory::msSlideSorterURL,
+        nStripX, nBottomY + 21, aBox.Width - nMargin - nEndBarWidth - 12 - nStripX, 54);
+
+    // Between the bars: the slide on screen takes the board's share of the
+    // width, less on a screen too low for it; the next slide and the notes
+    // share the rest.
+    const double nTop (nTopBar + nPadding);
+    const double nHeight (aBox.Height - nBottomBar - nPadding - nTop);
+    const double nWidth (aBox.Width - 2*nMargin - nGap);
+    double nCurrentWidth (nWidth * 0.627);
+    awt::Size aCurrent (CalculatePaneSize(nCurrentWidth, PresenterPaneFactory::msCurrentSlidePreviewPaneURL));
+    if (aCurrent.Height > nHeight && aCurrent.Height > 0)
+    {
+        nCurrentWidth = nCurrentWidth * nHeight / aCurrent.Height;
+        aCurrent = CalculatePaneSize(nCurrentWidth, PresenterPaneFactory::msCurrentSlidePreviewPaneURL);
+    }
+    SetPanePosSizeAbsolute(PresenterPaneFactory::msCurrentSlidePreviewPaneURL,
+        nMargin, nTop, aCurrent.Width, aCurrent.Height);
+
+    const double nRightX (nMargin + aCurrent.Width + nGap);
+    double nRightWidth (aBox.Width - nMargin - nRightX);
+    if (nRightWidth < 160)
+        nRightWidth = 160;
+    double nNextWidth (nRightWidth);
+    awt::Size aNext (CalculatePaneSize(nNextWidth, PresenterPaneFactory::msNextSlidePreviewPaneURL));
+    if (aNext.Height > nHeight * 0.5 && aNext.Height > 0)
+    {
+        nNextWidth = nNextWidth * nHeight * 0.5 / aNext.Height;
+        aNext = CalculatePaneSize(nNextWidth, PresenterPaneFactory::msNextSlidePreviewPaneURL);
+    }
+    SetPanePosSizeAbsolute(PresenterPaneFactory::msNextSlidePreviewPaneURL,
+        nRightX, nTop, aNext.Width, aNext.Height);
+
+    const double nNotesY (nTop + aNext.Height + 14);
+    if (nTop + nHeight - nNotesY > 40)
+        SetPanePosSizeAbsolute(PresenterPaneFactory::msNotesPaneURL,
+            nRightX, nNotesY, nRightWidth, nTop + nHeight - nNotesY);
+}

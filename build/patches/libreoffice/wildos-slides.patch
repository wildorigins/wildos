+void PresenterSlideSorter::Layout::UpdateStrip (
+    const geometry::RealRectangle2D& rBoundingBox,
+    const double nSlideAspectRatio)
+{
+    maBoundingBox = rBoundingBox;
+
+    mnHorizontalBorder = 0;
+    mnVerticalBorder = 4;
+
+    const double nWidth (rBoundingBox.X2 - rBoundingBox.X1);
+    const double nHeight (rBoundingBox.Y2 - rBoundingBox.Y1 - 2*mnVerticalBorder);
+    if (nWidth<=0 || nHeight<=0)
+        return;
+
+    const double nPreviewWidth (nHeight * nSlideAspectRatio);
+    mnHorizontalGap = 10;
+    mnColumnCount = ::std::max(sal_Int32(1),
+        sal_Int32(floor((nWidth + mnHorizontalGap) / (nPreviewWidth + mnHorizontalGap))));
+    mnRowCount = 1;
+    // Enough that the row below never shows at the box's lower edge.
+    mnVerticalGap = 4*mnVerticalBorder;
+    maPreviewSize = geometry::IntegerSize2D(floor(nPreviewWidth), floor(nHeight));
+
+    mnVerticalOffset = 0;
+    const sal_Int32 nShown (::std::min(mnColumnCount, ::std::max(sal_Int32(1), mnSlideCount)));
+    mnHorizontalOffset = round(-(nWidth
+        - nShown*maPreviewSize.Width
+        - (nShown-1)*mnHorizontalGap));
+}
+
+bool PresenterSlideSorter::Layout::ShowRowOf (const sal_Int32 nSlideIndex)
+{
+    if (nSlideIndex < 0 || mnColumnCount <= 0)
+        return false;
+    const sal_Int32 nOffset (GetRow(nSlideIndex) * (maPreviewSize.Height + mnVerticalGap));
+    if (nOffset == mnVerticalOffset)
+        return false;
+    mnVerticalOffset = nOffset;
+    SetupVisibleArea();
+    return true;
+}

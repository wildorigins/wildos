+
+/// The role a partition has: set by this page, or worked out for one it never touched.
+QString
+DiskEditorPage::roleOf( Partition* p ) const
+{
+    if ( !p )
+    {
+        for ( const auto& e : m_entries )
+        {
+            if ( e.first == m_selectedFirst && e.partition )
+            {
+                return e.role;
+            }
+        }
+        return QString();
+    }
+    const QVariant set = p->property( "wildosRole" );
+    if ( set.isValid() )
+    {
+        return set.toString();
+    }
+    if ( p->activeFlags().testFlag( PartitionTable::Flag::BiosGrub ) )
+    {
+        return QStringLiteral( "biosboot" );
+    }
+    // The EFI system partition, whether this computer started in UEFI mode or not.
+    if ( !isPartitionNew( p )
+         && ( PartUtils::isEfiBootable( p ) || p->activeFlags().testFlag( PartitionTable::Flag::Boot )
+              || p->label() == QStringLiteral( "EFI" ) ) )
+    {
+        return QStringLiteral( "esp" );
+    }
+    if ( !isPartitionNew( p ) && p->partitionPath() == m_windowsPath )
+    {
+        return QStringLiteral( "windows" );
+    }
+    if ( isPartitionNew( p ) )
+    {
+        return QString();
+    }
+    return QStringLiteral( "unused" );
+}
+
+QString
+DiskEditorPage::nameOf( Partition* p, const QString& role ) const
+{
+    const QString fs = p->fileSystem().name();
+    const bool ntfs = p->fileSystem().type() == FileSystem::Ntfs;
+    const bool small = p->capacity() < 3 * GB;
+    if ( role == "system" )
+    {
+        return tr( "Wild OS system" );
+    }
+    if ( role == "boot" )
+    {
+        return tr( "Wild OS start-up files" );
+    }
+    if ( role == "biosboot" )
+    {
+        return tr( "BIOS start-up area" );
+    }
+    if ( role == "home" )
+    {
+        return tr( "Your files (Home)" );
+    }
+    if ( role == "swap" )
+    {
+        return tr( "Swap" );
+    }
+    if ( role == "shared" )
+    {
+        return tr( "Shared with Windows" );
+    }
+    if ( role == "esp" )
+    {
+        return tr( "Windows start-up files" );
+    }
+    if ( role == "windows" )
+    {
+        return tr( "Windows (C:)" );
+    }
+    if ( role.isEmpty() )
+    {
+        return tr( "New partition" );
+    }
+    if ( ntfs && ( small || p->label().contains( "Recovery", Qt::CaseInsensitive ) ) )
+    {
+        return tr( "Windows recovery" );
+    }
+    if ( ( p->fileSystem().type() == FileSystem::Unknown || p->activeFlags().testFlag( PartitionTable::Flag::MsftReserved ) )
+         && small )
+    {
+        return tr( "Windows reserved" );
+    }
+    if ( !p->label().isEmpty() )
+    {
+        return p->label();
+    }
+    if ( ntfs )
+    {
+        return tr( "Windows data" );
+    }
+    return tr( "Other partition (%1)" ).arg( fs );
+}
+
+void
+DiskEditorPage::rebuild()
+{
+    m_entries.clear();
+    Device* d = device();
+    if ( !d )
+    {
+        return;
+    }
+    m_rows->m_sectorSize = d->logicalSize();
+
+    // Windows (C:) is the partition os-prober found Windows on, or else the
+    // biggest NTFS partition of 20 GB or more (with UEFI, os-prober reports
+    // Windows on the start-up partition instead).
+    // Worked out on the disk as it was, so it still names Windows after it
+    // is deleted here.
+    m_windowsPath.clear();
+    qint64 biggest = 0;
+    Device* original = m_core->immutableDeviceCopy( d );
+    for ( auto it = PartitionIterator::begin( original ); it != PartitionIterator::end( original ); ++it )
+    {
+        Partition* p = *it;
+        for ( const auto& entry : m_core->osproberEntries() )
+        {
+            if ( entry.path == p->partitionPath() && entry.prettyName.contains( "Windows", Qt::CaseInsensitive ) )
+            {
+                biggest = std::numeric_limits< qint64 >::max();
+                m_windowsPath = p->partitionPath();
+            }
+        }
+        if ( p->fileSystem().type() == FileSystem::Ntfs && p->capacity() >= 20 * GB && p->capacity() > biggest
+             && !isPartitionNew( p ) )
+        {
+            biggest = p->capacity();
+            m_windowsPath = p->partitionPath();
+        }
+    }
+    m_subtitle->setText( tr( "%1, %2. Nothing changes until you press Install." )
+                             .arg( friendlyDiskName( d ), gbText( d->capacity() ) ) );
+
+    for ( auto it = PartitionIterator::begin( d ); it != PartitionIterator::end( d ); ++it )
+    {
+        Partition* p = *it;
+        if ( p->roles().has( PartitionRole::Extended ) )
+        {
+            continue;
+        }
+        Entry e;
+        e.first = p->firstSector();
+        e.last = p->lastSector();
+        if ( isPartitionFreeSpace( p ) )
+        {
+            if ( p->capacity() < 64LL * 1024 * 1024 )
+            {
+                continue;  // Alignment slivers
+            }
+            e.colour = QColor( 255, 255, 255, 15 );
+            m_entries.append( e );
+            continue;
+        }
+        e.partition = p;
+        e.role = roleOf( p );
+        e.isNew = isPartitionNew( p );
+        e.name = nameOf( p, e.role );
+        e.colour = roleColour( e.role );
+        const bool encrypted = p->roles().has( PartitionRole::Luks );
+        const FileSystem* fs = &p->fileSystem();
+        if ( encrypted )
+        {
+            if ( auto* luks = dynamic_cast< const FS::luks* >( fs ); luks && luks->innerFS() )
+            {
+                fs = luks->innerFS();
+            }
+        }
+        if ( e.role == "esp" )
+        {
+            e.detail = tr( "EFI system" );
+        }
+        else if ( e.role == "biosboot" )
+        {
+            e.detail = tr( "for starting from GPT on BIOS computers" );
+        }
+        else if ( e.role == "swap" )
+        {
+            e.detail = encrypted ? tr( "used when memory is full, encrypted" ) : tr( "used when memory is full" );
+        }
+        else if ( e.role.isEmpty() )
+        {
+            e.detail = tr( "Choose what it is for" );
+        }
+        else
+        {
+            QString fsName = fs->name();
+            if ( fs->type() == FileSystem::Ntfs || fs->type() == FileSystem::Fat32 || fs->type() == FileSystem::Exfat )
+            {
+                fsName = fsName.toUpper();
+            }
+            else if ( fs->type() == FileSystem::Unknown || fs->type() == FileSystem::Unformatted )
+            {
+                fsName = tr( "no file system Wild OS knows" );
+            }
+            e.detail = encrypted ? tr( "%1, encrypted" ).arg( fsName ) : fsName;
+        }
+        m_entries.append( e );
+    }
+
+    bool selectedExists = false;
+    for ( const auto& e : m_entries )
+    {
+        selectedExists = selectedExists || ( e.partition && e.first == m_selectedFirst );
+    }
+    if ( !selectedExists )
+    {
+        m_selectedFirst = -1;
+        for ( const auto& e : m_entries )
+        {
+            if ( e.partition && m_selectedFirst < 0 )
+            {
+                m_selectedFirst = e.first;
+            }
+        }
+    }
+
+    // The existing EFI system partition is where Wild OS starts from too.
+    if ( PartUtils::isEfiSystem() )
+    {
+        const QString espMount
+            = Calamares::JobQueue::instance()->globalStorage()->value( "efiSystemPartition" ).toString();
+        for ( const auto& e : m_entries )
+        {
+            if ( e.role == "esp" && PartitionInfo::mountPoint( e.partition ) != espMount )
+            {
+                PartitionInfo::setMountPoint( e.partition, espMount );
+            }
+        }
+    }
+
+    m_map->setEntries( m_entries, m_selectedFirst );
+    m_rows->setEntries( m_entries, m_selectedFirst );
+    m_summary->setText( summaryText() );
+
+    bool hasSystem = false;
+    bool allRoles = true;
+    bool hasFree = false;
+    for ( const auto& e : m_entries )
+    {
+        hasSystem = hasSystem || e.role == "system";
+        allRoles = allRoles && ( !e.partition || !e.role.isEmpty() );
+        hasFree = hasFree || !e.partition;
+    }
+    m_add->setEnabled( hasFree );
+    const bool complete = hasSystem && allRoles;
+    if ( complete != m_complete )
+    {
+        m_complete = complete;
+        Q_EMIT nextStatusChanged( complete );
+    }
+    showSelected();
+}
+
+void
+DiskEditorPage::select( qint64 firstSector )
+{
+    m_selectedFirst = firstSector;
+    m_map->setEntries( m_entries, m_selectedFirst );
+    m_rows->setEntries( m_entries, m_selectedFirst );
+    showSelected();
+}
+
+qint64
+DiskEditorPage::maxSizeFor( const Entry& e ) const
+{
+    // A new partition can grow into the free space right after it.
+    qint64 last = e.last;
+    for ( int i = 0; i + 1 < m_entries.count(); ++i )
+    {
+        if ( m_entries[ i ].first == e.first && !m_entries[ i + 1 ].partition )
+        {
+            last = m_entries[ i + 1 ].last;
+        }
+    }
+    return ( last - e.first + 1 ) * device()->logicalSize();
+}
+
+void
+DiskEditorPage::showSelected()
+{
+    m_updating = true;
+    const Entry* sel = nullptr;
+    for ( const auto& e : m_entries )
+    {
+        if ( e.partition && e.first == m_selectedFirst )
+        {
+            sel = &e;
+        }
+    }
+    const bool any = sel != nullptr;
+    m_delete->setEnabled( any && sel->role != "esp" && sel->role != "boot" && sel->role != "biosboot" );
+    m_panelTitle->setText( any ? sel->name : tr( "No partition picked" ) );
+    if ( !any )
+    {
+        m_panelNote->setText( tr( "Pick a partition in the list or on the map, or add one in free space." ) );
+        m_panelNote->show();
+        for ( auto* w : { m_roleBox, m_sizeBox, m_encryptRow, m_eraseRow } )
+        {
+            w->hide();
+        }
+        m_path->clear();
+        m_updating = false;
+        return;
+    }
+    Partition* p = sel->partition;
+    const bool fixed
+        = sel->role == "esp" || sel->role == "boot" || sel->role == "biosboot" || sel->role == "windows";
+    m_panelNote->setVisible( fixed || sel->role.isEmpty() );
+    if ( sel->role == "esp" )
+    {
+        m_panelNote->setText( tr( "Windows and Wild OS both start from here. Wild OS adds its own start-up "
+                                  "entry and changes nothing else." ) );
+    }
+    else if ( sel->role == "biosboot" )
+    {
+        m_panelNote->setText( tr( "Made with the Wild OS system partition on this BIOS computer. The start-up "
+                                  "program keeps a part of itself here." ) );
+    }
+    else if ( sel->role == "boot" )
+    {
+        m_panelNote->setText( tr( "Made with the Wild OS system partition. It holds what the computer needs "
+                                  "before the disk password is typed, so it is never encrypted." ) );
+    }
+    else if ( sel->role == "windows" )
+    {
+        m_panelNote->setText( tr( "Windows and its files. To make room beside it, go back and choose "
+                                  "Install alongside Windows, or delete it here to erase it." ) );
+    }
+    else if ( sel->role.isEmpty() )
+    {
+        m_panelNote->setText( tr( "Choose what this partition is for." ) );
+    }
+
+    m_roleBox->setVisible( !fixed );
+    bool hasSystemElsewhere = false;
+    for ( const auto& e : m_entries )
+    {
+        hasSystemElsewhere = hasSystemElsewhere || ( e.role == "system" && e.first != sel->first );
+    }
+    for ( int i = 0; i < m_roleButtons.count(); ++i )
+    {
+        m_roleButtons[ i ]->setChecked( pickableRoles[ i ] == sel->role );
+        m_roleButtons[ i ]->setEnabled( !( pickableRoles[ i ] == "system" && hasSystemElsewhere ) );
+    }
+
+    const bool isNew = sel->isNew;
+    const qint64 sizeBytes = ( sel->last - sel->first + 1 ) * device()->logicalSize();
+    m_sizeBox->setVisible( !fixed && isNew );
+    m_size->setEnabled( isNew );
+    m_sizeField->setEnabled( isNew );
+    const qint64 maxBytes = isNew ? maxSizeFor( *sel ) : sizeBytes;
+    m_size->setRange( 1, int( qMax< qint64 >( 1, maxBytes / GB ) ) );
+    m_size->setValue( int( qMax< qint64 >( 1, qRound64( sizeBytes / 1e9 ) ) ) );
+    m_sizeField->setText( gbText( sizeBytes ) );
+
+    const bool encryptable = sel->role == "system" || sel->role == "home" || sel->role == "swap";
+    m_encryptRow->setVisible( !fixed && encryptable );
+    m_encrypt->setChecked( p->roles().has( PartitionRole::Luks ) );
+    m_encrypt->setEnabled( isNew || PartitionInfo::format( p ) );
+
+    m_eraseRow->setVisible( !fixed && sel->role != "unused" );
+    m_erase->setChecked( isNew || PartitionInfo::format( p ) );
+    m_erase->setEnabled( !isNew );
+    m_eraseDetail->setText( isNew ? tr( "Needed for a new partition" )
+                                  : tr( "Wipes what is on it and starts afresh" ) );
+
+    const QString mount = PartitionInfo::mountPoint( p );
+    QString path = p->partitionPath().isEmpty() ? device()->deviceNode() : p->partitionPath();
+    path += QStringLiteral( " · " )
+        + ( sel->role.isEmpty() ? tr( "not formatted yet" ) : sel->detail.section( ',', 0, 0 ) );
+    if ( !mount.isEmpty() )
+    {
+        path += QStringLiteral( " · " ) + tr( "mounted at %1" ).arg( mount );
+    }
+    m_path->setText( path );
+    m_updating = false;
+}
+
+/** @brief Give the selected partition a role, size and encryption
+ *
+ * Kept partitions only change their mount point. Anything that is erased
+ * or new is made again from scratch over the same space, the way the stock
+ * dialogs do it: delete, then create.
+ */
+void
+DiskEditorPage::apply( const QString& role, qint64 sizeBytes, bool encrypt, bool erase )
+{
+    Device* d = device();
+    Partition* p = nullptr;
+    QString oldRole;
+    for ( const auto& e : m_entries )
+    {
+        if ( e.partition && e.first == m_selectedFirst )
+        {
+            p = e.partition;
+            oldRole = e.role;
+        }
+    }
+    if ( !d || !p || role == "esp" || role == "boot" || role == "biosboot" || role == "windows" )
+    {
+        return;
+    }
+    const bool mbr = d->partitionTable() && d->partitionTable()->type() == PartitionTable::msdos;
+    const bool gptOnBios = !PartUtils::isEfiSystem() && d->partitionTable()
+        && d->partitionTable()->type() == PartitionTable::gpt;
+    const bool isNew = isPartitionNew( p );
+    const FileSystem::Type fsNow = p->fileSystem().type();
+    const bool linuxFs = fsNow == FileSystem::Ext4 || fsNow == FileSystem::Btrfs || fsNow == FileSystem::Xfs
+        || fsNow == FileSystem::Ext3;
+    const bool windowsFs = fsNow == FileSystem::Ntfs || fsNow == FileSystem::Exfat || fsNow == FileSystem::Fat32;
+
+    // A new role for a kept partition starts out with the safe default:
+    // keep its files where the role allows it, erase where it must.
+    if ( !isNew && role != oldRole )
+    {
+        erase = !( ( role == "home" && linuxFs ) || ( role == "shared" && windowsFs ) || role == "unused" );
+    }
+    if ( role == "system" || role == "swap" )
+    {
+        erase = true;
+    }
+    if ( role != oldRole && ( role == "system" || role == "home" || role == "swap" ) && oldRole != "system"
+         && oldRole != "home" && oldRole != "swap" )
+    {
+        encrypt = true;  // Encrypted unless someone turns it off
+    }
+
+    static const QMap< QString, QString > mountFor { { "system", "/" },
+                                                     { "home", "/home" },
+                                                     { "shared", "/media/shared" } };
+
+    if ( !isNew && !erase )
+    {
+        m_core->clearJobs( d, p );
+        PartitionInfo::reset( p );
+        PartitionInfo::setMountPoint( p, mountFor.value( role ) );
+        PartitionInfo::setFormat( p, false );
+        p->setProperty( "wildosRole", role );
+        rebuild();
+        return;
+    }
+
+    // Leaving the system role behind takes its start-up partition with it.
+    if ( oldRole == "system" && role != "system" )
+    {
+        for ( const auto& e : m_entries )
+        {
+            if ( e.role == "boot" )
+            {
+                m_core->deletePartition( d, e.partition );
+            }
+        }
+    }
+
+    qint64 first = p->firstSector();
+    qint64 last = p->lastSector();
+    if ( isNew && sizeBytes > 0 )
+    {
+        const Entry* sel = nullptr;
+        for ( const auto& e : m_entries )
+        {
+            if ( e.partition == p )
+            {
+                sel = &e;
+            }
+        }
+        const qint64 maxBytes = sel ? maxSizeFor( *sel ) : p->capacity();
+        const qint64 bytes = qBound< qint64 >( GB, sizeBytes, maxBytes );
+        last = first + bytes / d->logicalSize() - 1;
+    }
+    PartitionNode* parent = p->parent();
+    const PartitionRole partRole( p->roles().has( PartitionRole::Logical ) ? PartitionRole::Logical
+                                                                           : PartitionRole::Primary );
+    m_core->deletePartition( d, p );
+
+    bool needBoot = role == "system";
+    for ( const auto& e : m_entries )
+    {
+        needBoot = needBoot && e.role != "boot";
+    }
+    // On an MBR disk a primary partition here and one for /boot must fit in
+    // its four. A logical one (inside an extended partition) has no limit.
+    if ( needBoot && mbr && !partRole.has( PartitionRole::Logical ) && primaryCount( d ) + 1 > 4 )
+    {
+        rebuild();
+        m_summary->setText( tr( "<b>No room for a start-up partition.</b> This disk already has four main "
+                                "partitions. Delete one, or use a partition inside its extended partition." ) );
+        return;
+    }
+    const qint64 align = qMax< qint64 >( 1, 1024 * 1024 / d->logicalSize() );
+    bool needBiosBoot = needBoot && gptOnBios;
+    for ( auto it = PartitionIterator::begin( d ); it != PartitionIterator::end( d ); ++it )
+    {
+        needBiosBoot = needBiosBoot && !( *it )->activeFlags().testFlag( PartitionTable::Flag::BiosGrub );
+    }
+    if ( needBiosBoot )
+    {
+        const qint64 biosLast = first + align - 1;
+        Partition* bios = KPMHelpers::createNewPartition( parent,
+                                                          *d,
+                                                          partRole,
+                                                          FileSystem::Unformatted,
+                                                          QStringLiteral( "BIOS boot" ),
+                                                          first,
+                                                          biosLast,
+                                                          PartitionTable::Flags() );
+        PartitionInfo::setFormat( bios, false );
+        bios->setProperty( "wildosRole", QStringLiteral( "biosboot" ) );
+        m_core->createPartition( d, bios, PartitionTable::Flag::BiosGrub );
+        first = biosLast + 1;
+    }
+    if ( needBoot && ( last - first + 1 ) * d->logicalSize() > BOOT_SIZE + 20 * GB )
+    {
+        const qint64 bootLast = first + BOOT_SIZE / d->logicalSize() - 1;
+        Partition* boot = KPMHelpers::createNewPartition(
+            parent, *d, partRole, FileSystem::Ext4, QString(), first, bootLast, PartitionTable::Flags() );
+        PartitionInfo::setMountPoint( boot, QStringLiteral( "/boot" ) );
+        PartitionInfo::setFormat( boot, true );
+        boot->setProperty( "wildosRole", QStringLiteral( "boot" ) );
+        m_core->createPartition( d, boot );
+        // A logical partition after it needs room for its boot record.
+        first = bootLast + 1 + ( partRole.has( PartitionRole::Logical ) ? align : 0 );
+    }
+
+    FileSystem::Type fsType = FileSystem::Unformatted;
+    if ( role == "system" || role == "home" )
+    {
+        fsType = FileSystem::Ext4;
+    }
+    else if ( role == "swap" )
+    {
+        fsType = FileSystem::LinuxSwap;
+    }
+    else if ( role == "shared" )
+    {
+        fsType = FileSystem::Ntfs;
+    }
+    const bool encrypted = encrypt && ( role == "system" || role == "home" || role == "swap" );
+    Partition* made = encrypted
+        ? KPMHelpers::createNewEncryptedPartition( parent,
+                                                   *d,
+                                                   partRole,
+                                                   fsType,
+                                                   QString(),
+                                                   first,
+                                                   last,
+                                                   m_config.luksFileSystemType(),
+                                                   EncryptWidget::placeholderPassphrase(),
+                                                   PartitionTable::Flags() )
+        : KPMHelpers::createNewPartition(
+              parent, *d, partRole, fsType, QString(), first, last, PartitionTable::Flags() );
+    PartitionInfo::setMountPoint( made, mountFor.value( role ) );
+    PartitionInfo::setFormat( made, fsType != FileSystem::Unformatted );
+    made->setProperty( "wildosRole", role );
+    m_core->createPartition( d, made );
+    m_selectedFirst = made->firstSector();
+    rebuild();
+}
+
+int
+DiskEditorPage::primaryCount( Device* d ) const
+{
+    int count = 0;
+    if ( d && d->partitionTable() )
+    {
+        for ( const Partition* p : d->partitionTable()->children() )
+        {
+            count += ( p->roles().has( PartitionRole::Primary ) || p->roles().has( PartitionRole::Extended ) ) ? 1 : 0;
+        }
+    }
+    return count;
+}
+
+void
+DiskEditorPage::addPartition()
+{
+    Device* d = device();
+    Partition* free = nullptr;
+    for ( auto it = PartitionIterator::begin( d ); it != PartitionIterator::end( d ); ++it )
+    {
+        if ( isPartitionFreeSpace( *it ) && ( !free || ( *it )->capacity() > free->capacity() ) )
+        {
+            free = *it;
+        }
+    }
+    if ( !free )
+    {
+        return;
+    }
+    // Start and end on whole mebibytes, as partitioning tools do.
+    const qint64 align = qMax< qint64 >( 1, 1024 * 1024 / d->logicalSize() );
+    const qint64 first = ( ( free->firstSector() + align - 1 ) / align ) * align;
+    const qint64 last = ( ( free->lastSector() + 1 ) / align ) * align - 1;
+    if ( last <= first )
+    {
+        return;
+    }
+    Partition* made = KPMHelpers::createNewPartition( free->parent(),
+                                                      *d,
+                                                      PartitionRole( PartitionRole::Primary ),
+                                                      FileSystem::Unformatted,
+                                                      QString(),
+                                                      first,
+                                                      last,
+                                                      PartitionTable::Flags() );
+    PartitionInfo::setFormat( made, false );
+    made->setProperty( "wildosRole", QString() );
+    m_core->createPartition( d, made );
+    m_selectedFirst = made->firstSector();
+    rebuild();
+}
+
+void
+DiskEditorPage::deleteSelected()
+{
+    Device* d = device();
+    for ( const auto& e : m_entries )
+    {
+        if ( e.partition && e.first == m_selectedFirst )
+        {
+            const bool system = e.role == "system";
+            m_core->deletePartition( d, e.partition );
+            if ( system )
+            {
+                for ( const auto& b : m_entries )
+                {
+                    if ( b.role == "boot" )
+                    {
+                        m_core->deletePartition( d, b.partition );
+                    }
+                }
+            }
+            break;
+        }
+    }
+    m_selectedFirst = -1;
+    rebuild();
+}
+
+QString
+DiskEditorPage::summaryText( QStringList* erasedOut ) const
+{
+    Device* d = device();
+    Device* before = d ? m_core->immutableDeviceCopy( d ) : nullptr;
+    QStringList erased;
+    bool windowsKept = false;
+    if ( before )
+    {
+        for ( auto it = PartitionIterator::begin( before ); it != PartitionIterator::end( before ); ++it )
+        {
+            Partition* old = *it;
+            if ( isPartitionFreeSpace( old ) || old->roles().has( PartitionRole::Extended ) )
+            {
+                continue;
+            }
+            bool kept = false;
+            for ( const auto& e : m_entries )
+            {
+                kept = kept
+                    || ( e.partition && !e.isNew && e.first == old->firstSector()
+                         && !PartitionInfo::format( e.partition ) );
+            }
+            const QString role = roleOf( old );
+            if ( !kept )
+            {
+                erased << nameOf( old, role );
+            }
+            else if ( role == QStringLiteral( "windows" ) )
+            {
+                windowsKept = true;
+            }
+        }
+    }
+    if ( erasedOut )
+    {
+        *erasedOut = erased;
+    }
+    int created = 0;
+    for ( const auto& e : m_entries )
+    {
+        created += ( e.partition && e.isNew ) ? 1 : 0;
+    }
+    QString text = erased.isEmpty()
+        ? tr( "<b>Will erase: nothing.</b>" )
+        : tr( "<b>Will erase: %1.</b>" ).arg( erased.join( QStringLiteral( ", " ) ).toHtmlEscaped() );
+    if ( created > 0 )
+    {
+        text += QStringLiteral( " " )
+            + ( created == 1 ? tr( "Will create 1 new partition." )
+                             : tr( "Will create %1 new partitions." ).arg( created ) );
+    }
+    if ( windowsKept )
+    {
+        text += QStringLiteral( " " ) + tr( "Windows and its files stay as they are." );
+    }
+    return text;
+}
+
+bool
+DiskEditorPage::isComplete() const
+{
+    return m_complete;
+}
+
+void
+DiskEditorPage::onLeave()
+{
+    Device* d = device();
+    if ( !d )
+    {
+        return;
+    }
+    if ( !PartUtils::isEfiSystem() )
+    {
+        m_core->setBootLoaderInstallPath( d->deviceNode() );
+    }
+    QVariantMap plan;
+    plan.insert( "mode", "manual" );
+    plan.insert( "disk", friendlyDiskName( d ) );
+    plan.insert( "diskNode", d->deviceNode() );
+    plan.insert( "diskSize", d->capacity() );
+    qint64 wildos = 0;
+    QStringList erased;
+    for ( const auto& e : m_entries )
+    {
+        if ( e.role == "system" || e.role == "home" || e.role == "swap" || e.role == "boot" )
+        {
+            wildos += ( e.last - e.first + 1 ) * d->logicalSize();
+        }
+    }
+    plan.insert( "wildosSize", wildos );
+    plan.insert( "summary", summaryText( &erased ) );
+    plan.insert( "erase", erased );
+    Calamares::JobQueue::instance()->globalStorage()->insert( "wildosPlan", plan );
+}

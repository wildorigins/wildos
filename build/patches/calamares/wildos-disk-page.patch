+/** @brief A short name for the other system on the disk, if there is one
+ *
+ * "Windows" for any Windows, the name os-prober gives otherwise, and an
+ * empty string for none or for several different systems.
+ */
+QString
+ChoicePage::otherSystemName() const
+{
+    Device* device = m_core ? const_cast< ChoicePage* >( this )->selectedDevice() : nullptr;
+    if ( !device )
+    {
+        return QString();
+    }
+    const auto entries = getOsproberEntriesForDevice( device );
+    bool allWindows = !entries.isEmpty();
+    for ( const auto& entry : entries )
+    {
+        allWindows = allWindows && entry.prettyName.contains( QStringLiteral( "Windows" ), Qt::CaseInsensitive );
+    }
+    if ( allWindows )
+    {
+        return QStringLiteral( "Windows" );
+    }
+    if ( entries.count() == 1 )
+    {
+        return entries.first().prettyName.isEmpty() ? tr( "another system" ) : entries.first().prettyName;
+    }
+    return QString();
+}
+
+QString
+ChoicePage::alongsideBlockedReason() const
+{
+    const QString reason = Calamares::JobQueue::instance()->globalStorage()->value( "alongsideBlocked" ).toString();
+    if ( reason == QStringLiteral( "bitlocker" ) )
+    {
+        return tr( "Not available while BitLocker is on in Windows. See Before we start." );
+    }
+    if ( reason == QStringLiteral( "faststartup" ) )
+    {
+        return tr( "Not available while Windows Fast Startup is on. See Before we start." );
+    }
+    if ( reason == QStringLiteral( "dirty" ) )
+    {
+        return tr( "Not available until Windows is shut down fully. See Before we start." );
+    }
+    if ( reason == QStringLiteral( "space" ) )
+    {
+        return tr( "Windows needs 40 GB free for this. See Before we start." );
+    }
+    return QString();
+}
+
+void
+ChoicePage::applyAlongsideBlock()
+{
+    if ( !m_alongsideButton )
+    {
+        return;
+    }
+    const bool blocked = !alongsideBlockedReason().isEmpty();
+    if ( blocked == !m_alongsideButton->isEnabled() )
+    {
+        return;
+    }
+    m_alongsideButton->setEnabled( !blocked );
+    if ( blocked && m_alongsideButton->isChecked() )
+    {
+        checkInstallChoiceRadioButton( InstallChoice::NoChoice );
+        m_config->setInstallChoice( InstallChoice::NoChoice );
+        Q_EMIT actionChosen();
+    }
+    updateActionDescriptionsTr();
+    updateNextEnabled();
+}
+
+/** @brief What the summary page shows, in global storage as wildosPlan */
+void
+ChoicePage::storePlan()
+{
+    Device* device = selectedDevice();
+    QVariantMap plan;
+    plan.insert( "other", otherSystemName() );
+    if ( device )
+    {
+        plan.insert( "disk", friendlyDiskName( device ) );
+        plan.insert( "diskNode", device->deviceNode() );
+        plan.insert( "diskSize", device->capacity() );
+    }
+    switch ( m_config->installChoice() )
+    {
+    case InstallChoice::Alongside:
+        plan.insert( "mode", "alongside" );
+        if ( m_afterPartitionSplitterWidget )
+        {
+            plan.insert( "otherSize", m_afterPartitionSplitterWidget->splitPartitionSize() );
+            plan.insert( "wildosSize", m_afterPartitionSplitterWidget->newPartitionSize() );
+        }
+        plan.insert( "erase", QStringList() );
+        break;
+    case InstallChoice::Erase:
+        plan.insert( "mode", "erase" );
+        plan.insert( "wildosSize", device ? device->capacity() : 0 );
+        plan.insert( "erase", QStringList { QStringLiteral( "everything" ) } );
+        break;
+    default:
+        plan.insert( "mode", "manual" );
+        break;
+    }
+    Calamares::JobQueue::instance()->globalStorage()->insert( "wildosPlan", plan );
+}
+
+void
+ChoicePage::autoSelectPartitionToShrink()
+{
+    if ( !m_beforePartitionBarsView || !m_beforePartitionBarsView->model()
+         || m_config->installChoice() != InstallChoice::Alongside )
+    {
+        return;
+    }
+    const auto* model = m_beforePartitionBarsView->model();
+    Logger::Once o;
+    QModelIndex best;
+    qint64 bestScore = -1;
+    std::function< void( const QModelIndex& ) > visit = [ & ]( const QModelIndex& parent )
+    {
+        for ( int row = 0; row < model->rowCount( parent ); ++row )
+        {
+            const QModelIndex index = model->index( row, 0, parent );
+            auto* part = static_cast< Partition* >( index.data( PartitionModel::PartitionPtrRole ).value< void* >() );
+            if ( part && PartUtils::canBeResized( part, o ) )
+            {
+                // A partition with a system on it beats a bigger one without.
+                bool hasSystem = false;
+                for ( const OsproberEntry& entry : m_core->osproberEntries() )
+                {
+                    hasSystem = hasSystem || entry.path == part->partitionPath();
+                }
+                const qint64 score = part->capacity() + ( hasSystem ? ( qint64( 1 ) << 60 ) : 0 );
+                if ( score > bestScore )
+                {
+                    bestScore = score;
+                    best = index;
+                }
+            }
+            visit( index );
+        }
+    };
+    visit( QModelIndex() );
+    if ( best.isValid() )
+    {
+        // Going back to Alongside after another choice builds the page
+        // twice, the second time once that plan is undone, each with a new
+        // splitter. The second finds this partition already current, and
+        // Qt only signals a change, so that splitter is set up here.
+        auto* selection = m_beforePartitionBarsView->selectionModel();
+        if ( selection->currentIndex() == best )
+        {
+            doAlongsideSetupSplitter( best, QModelIndex() );
+        }
+        else
+        {
+            selection->setCurrentIndex( best, QItemSelectionModel::ClearAndSelect );
+        }
     }
 }
 

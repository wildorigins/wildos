+friendlyDiskName( Device* device )
+{
+    const QString name = device ? device->name().trimmed() : QString();
+    if ( name.isEmpty() || !device || device->deviceNode().endsWith( QStringLiteral( "/" ) + name ) )
+    {
+        return QObject::tr( "This disk" );
+    }
+    return name;
+}
+
+static constexpr qint64 GB = 1000LL * 1000 * 1000;
+static constexpr qint64 BOOT_SIZE = 1024LL * 1024 * 1024;
+
+static QString
+gbText( qint64 bytes )
+{
+    if ( bytes < GB )
+    {
+        return QStringLiteral( "%1 MB" ).arg( qMax< qint64 >( 1, qRound64( bytes / 1e6 ) ) );
+    }
+    return QStringLiteral( "%1 GB" ).arg( qRound64( bytes / 1e9 ) );
+}
+
+/// The roles people pick, in the order of the buttons.
+static const QStringList pickableRoles { "system", "home", "swap", "shared", "unused" };
+
+static QColor
+roleColour( const QString& role )
+{
+    if ( role == "system" || role == "boot" )
+    {
+        return QColor( 0x8f, 0xb4, 0xff );
+    }
+    if ( role == "home" )
+    {
+        return QColor( 0xb9, 0xa6, 0xf5 );
+    }
+    if ( role == "swap" )
+    {
+        return QColor( 0xee, 0xb0, 0xa4 );
+    }
+    if ( role == "shared" )
+    {
+        return QColor( 0x8f, 0xd6, 0xc4 );
+    }
+    if ( role == "windows" )
+    {
+        return QColor( 0x6c, 0x7a, 0x99 );
+    }
+    if ( role.isEmpty() )
+    {
+        return QColor( 0xe8, 0xec, 0xf8, 0x60 );
+    }
+    return QColor( 0x9a, 0xa4, 0xbd );
+}
+
+/// The disk map: one block per partition, sized by its share of the disk.
+class DiskMapView : public QWidget
+{
+    Q_OBJECT
+public:
+    explicit DiskMapView( QWidget* parent )
+        : QWidget( parent )
+    {
+        setFixedHeight( 46 );
+        setCursor( Qt::PointingHandCursor );
+    }
+    void setEntries( const QVector< DiskEditorPage::Entry >& entries, qint64 selected )
+    {
+        m_entries = entries;
+        m_selected = selected;
+        update();
+    }
+
+Q_SIGNALS:
+    void picked( qint64 first );
+
+protected:
+    QVector< QRectF > blocks() const
+    {
+        QVector< QRectF > out;
+        qint64 total = 0;
+        for ( const auto& e : m_entries )
+        {
+            total += e.last - e.first + 1;
+        }
+        const qreal gap = 2;
+        const qreal usable = width() - gap * qMax( 0, int( m_entries.count() ) - 1 );
+        qreal x = 0;
+        for ( const auto& e : m_entries )
+        {
+            const qreal w = total > 0 ? qMax< qreal >( 6, usable * qreal( e.last - e.first + 1 ) / total ) : 0;
+            out.append( QRectF( x, 0, w, height() ) );
+            x += w + gap;
+        }
+        return out;
+    }
+
+    void paintEvent( QPaintEvent* ) override
+    {
+        QPainter p( this );
+        p.setRenderHint( QPainter::Antialiasing );
+        QPainterPath clip;
+        clip.addRoundedRect( QRectF( rect() ), 10, 10 );
+        p.setClipPath( clip );
+        const auto rects = blocks();
+        QFont f = font();
+        f.setPixelSize( 11 );
+        f.setWeight( QFont::DemiBold );
+        p.setFont( f );
+        for ( int i = 0; i < m_entries.count(); ++i )
+        {
+            const auto& e = m_entries[ i ];
+            const QRectF r = rects[ i ];
+            if ( !e.partition )
+            {
+                p.fillRect( r, QColor( 255, 255, 255, 15 ) );
+                p.setPen( QPen( QColor( 255, 255, 255, 60 ), 1, Qt::DashLine ) );
+                p.drawRect( r.adjusted( 0.5, 0.5, -0.5, -0.5 ) );
+            }
+            else
+            {
+                p.fillRect( r, e.colour );
+            }
+            if ( e.first == m_selected )
+            {
+                p.setPen( QPen( Qt::white, 2 ) );
+                p.drawRect( r.adjusted( 1, 1, -1, -1 ) );
+            }
+            const QString label = e.partition ? e.name : tr( "Free space" );
+            if ( r.width() > 70 )
+            {
+                p.setPen( e.partition ? QColor( 0x0f, 0x15, 0x30 ) : QColor( 232, 236, 248, 180 ) );
+                p.drawText( r.adjusted( 8, 0, -4, -6 ),
+                            Qt::AlignLeft | Qt::AlignBottom,
+                            p.fontMetrics().elidedText( label, Qt::ElideRight, int( r.width() ) - 12 ) );
+            }
+        }
+    }
+
+    void mousePressEvent( QMouseEvent* event ) override
+    {
+        const auto rects = blocks();
+        for ( int i = 0; i < rects.count(); ++i )
+        {
+            if ( rects[ i ].contains( event->position() ) && m_entries[ i ].partition )
+            {
+                Q_EMIT picked( m_entries[ i ].first );
+            }
+        }
+    }
+
+private:
+    QVector< DiskEditorPage::Entry > m_entries;
+    qint64 m_selected = -1;
+};
+
+/// The partition list: colour, plain name and detail, size, and Keep as is or New.
+class PartitionRowsView : public QWidget
+{
+    Q_OBJECT
+public:
+    explicit PartitionRowsView( QWidget* parent )
+        : QWidget( parent )
+    {
+        setCursor( Qt::PointingHandCursor );
+        setFocusPolicy( Qt::StrongFocus );
+    }
+    void setEntries( const QVector< DiskEditorPage::Entry >& entries, qint64 selected )
+    {
+        m_entries.clear();
+        for ( const auto& e : entries )
+        {
+            if ( e.partition )
+            {
+                m_entries.append( e );
+            }
+        }
+        m_selected = selected;
+        setMinimumHeight( int( m_entries.count() ) * rowHeight );
+        update();
+    }
+    QSize sizeHint() const override { return QSize( 300, int( m_entries.count() ) * rowHeight ); }
+
+Q_SIGNALS:
+    void picked( qint64 first );
+
+protected:
+    static constexpr int rowHeight = 48;
+
+    void paintEvent( QPaintEvent* ) override
+    {
+        QPainter p( this );
+        p.setRenderHint( QPainter::Antialiasing );
+        QFont name = font();
+        name.setPixelSize( 13 );
+        QFont small = font();
+        small.setPixelSize( 11 );
+        QFont size = font();
+        size.setPixelSize( 12 );
+        for ( int i = 0; i < m_entries.count(); ++i )
+        {
+            const auto& e = m_entries[ i ];
+            const QRectF row( 0, i * rowHeight, width(), rowHeight );
+            const bool selected = e.first == m_selected;
+            if ( selected )
+            {
+                p.fillRect( row, QColor( 143, 180, 255, 31 ) );
+            }
+            p.setPen( QColor( 255, 255, 255, 15 ) );
+            p.drawLine( row.bottomLeft() - QPointF( 0, 0.5 ), row.bottomRight() - QPointF( 0, 0.5 ) );
+
+            p.setPen( Qt::NoPen );
+            p.setBrush( e.colour );
+            p.drawRoundedRect( QRectF( 14, row.center().y() - 6, 12, 12 ), 3, 3 );
+
+            // Right to left: the tag, then the size.
+            const QString tag = e.isNew ? tr( "New" ) : tr( "Keep as is" );
+            p.setFont( small );
+            name.setWeight( e.isNew ? QFont::DemiBold : QFont::Normal );
+            QFont tagFont = small;
+            tagFont.setWeight( e.isNew ? QFont::DemiBold : QFont::Normal );
+            p.setFont( tagFont );
+            const qreal tagW = p.fontMetrics().horizontalAdvance( tag ) + 16;
+            const QRectF tagRect( width() - 14 - tagW, row.center().y() - 11, tagW, 22 );
+            p.setBrush( e.isNew ? QColor( 143, 180, 255, 46 ) : QColor( 255, 255, 255, 20 ) );
+            p.drawRoundedRect( tagRect, 11, 11 );
+            p.setPen( e.isNew ? QColor( 0xc9, 0xd8, 0xff ) : QColor( 232, 236, 248, 204 ) );
+            p.drawText( tagRect, Qt::AlignCenter, tag );
+
+            p.setFont( size );
+            const QString sizeText = gbText( ( e.last - e.first + 1 ) * m_sectorSize );
+            const qreal sizeW = p.fontMetrics().horizontalAdvance( sizeText );
+            const QRectF sizeRect( tagRect.left() - 12 - sizeW, row.top(), sizeW, rowHeight );
+            p.setPen( QColor( 232, 236, 248, 204 ) );
+            p.drawText( sizeRect, Qt::AlignVCenter | Qt::AlignRight, sizeText );
+
+            const qreal textLeft = 38;
+            const qreal textWidth = sizeRect.left() - 12 - textLeft;
+            name.setWeight( selected ? QFont::DemiBold : QFont::Normal );
+            p.setFont( name );
+            p.setPen( QColor( 0xee, 0xf1, 0xf8 ) );
+            p.drawText( QRectF( textLeft, row.top() + 7, textWidth, 18 ),
+                        Qt::AlignLeft | Qt::AlignVCenter,
+                        p.fontMetrics().elidedText( e.name, Qt::ElideRight, int( textWidth ) ) );
+            p.setFont( small );
+            p.setPen( QColor( 232, 236, 248, 184 ) );
+            p.drawText( QRectF( textLeft, row.top() + 25, textWidth, 15 ),
+                        Qt::AlignLeft | Qt::AlignVCenter,
+                        p.fontMetrics().elidedText( e.detail, Qt::ElideRight, int( textWidth ) ) );
+        }
+    }
+
+    void mousePressEvent( QMouseEvent* event ) override
+    {
+        const int i = int( event->position().y() ) / rowHeight;
+        if ( i >= 0 && i < m_entries.count() )
+        {
+            Q_EMIT picked( m_entries[ i ].first );
+        }
+    }
+
+    void keyPressEvent( QKeyEvent* event ) override
+    {
+        int i = -1;
+        for ( int j = 0; j < m_entries.count(); ++j )
+        {
+            if ( m_entries[ j ].first == m_selected )
+            {
+                i = j;
+            }
+        }
+        if ( event->key() == Qt::Key_Down && i + 1 < m_entries.count() )
+        {
+            Q_EMIT picked( m_entries[ i + 1 ].first );
+        }
+        else if ( event->key() == Qt::Key_Up && i > 0 )
+        {
+            Q_EMIT picked( m_entries[ i - 1 ].first );
+        }
+        else
+        {
+            QWidget::keyPressEvent( event );
+        }
+    }
+
+public:
+    qint64 m_sectorSize = 512;
+
+private:
+    QVector< DiskEditorPage::Entry > m_entries;
+    qint64 m_selected = -1;
+};

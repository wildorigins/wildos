+}
+
+static constexpr int FOCUSED_HEIGHT = 44;
+static constexpr int FOCUSED_GAP = 6;
+
+static QString
+decimalGB( qint64 bytes )
+{
+    return QStringLiteral( "%1 GB" ).arg( qRound64( bytes / 1e9 ) );
+}
+
+QRectF
+PartitionSplitterWidget::focusedHandle() const
+{
+    const qint64 total = m_itemToResize.size + m_itemToResizeNext.size;
+    const qreal x = total > 0 ? width() * qreal( m_itemToResize.size ) / total : 0;
+    return QRectF( x - 7, 8, 20, FOCUSED_HEIGHT - 16 );
+}
+
+void
+PartitionSplitterWidget::setFocusedSplit( qint64 leftSize )
+{
+    const qint64 total = m_itemToResize.size + m_itemToResizeNext.size;
+    leftSize = qBound( m_itemMinSize, leftSize, qMin( m_itemMaxSize, total ) );
+    if ( leftSize == m_itemToResize.size )
+    {
+        return;
+    }
+    m_itemToResize.size = leftSize;
+    m_itemToResizeNext.size = total - leftSize;
+    countTransform( m_items,
+                    [ this ]( PartitionSplitterItem& item ) -> bool
+                    {
+                        if ( item.status == PartitionSplitterItem::Resizing )
+                        {
+                            item.size = m_itemToResize.size;
+                            return true;
+                        }
+                        if ( item.status == PartitionSplitterItem::ResizingNext )
+                        {
+                            item.size = m_itemToResizeNext.size;
+                            return true;
+                        }
+                        return false;
+                    } );
+    update();
+    Q_EMIT partitionResized( m_itemToResize.itemPath, m_itemToResize.size, m_itemToResizeNext.size );
+}
+
+void
+PartitionSplitterWidget::paintFocused( QPainter* painter )
+{
+    const QRectF bar( 0, 0, width(), FOCUSED_HEIGHT );
+    const QRectF handle = focusedHandle();
+    const qreal split = handle.left() + 7;
+
+    QPainterPath outline;
+    outline.addRoundedRect( bar, 10, 10 );
+    painter->setClipPath( outline );
+    painter->fillRect( QRectF( 0, 0, split, FOCUSED_HEIGHT ), QColor( 255, 255, 255, 36 ) );
+    painter->fillRect( QRectF( split, 0, FOCUSED_GAP, FOCUSED_HEIGHT ), QColor( 0x1a, 0x1c, 0x20 ) );
+    painter->fillRect( QRectF( split + FOCUSED_GAP, 0, width() - split - FOCUSED_GAP, FOCUSED_HEIGHT ),
+                       QColor( 0x8f, 0xb4, 0xff ) );
+
+    QFont nameFont = font();
+    nameFont.setPixelSize( 12 );
+    nameFont.setWeight( QFont::DemiBold );
+    QFont sizeFont = nameFont;
+    const auto drawHalf
+        = [ & ]( const QRectF& r, const QString& name, qint64 bytes, const QColor& colour, QFont::Weight weight )
+    {
+        const QRectF text = r.adjusted( 14, 0, -14, 0 );
+        if ( text.width() < 60 )
+        {
+            return;
+        }
+        sizeFont.setWeight( weight );
+        const QString size = decimalGB( bytes );
+        const qreal needed = QFontMetricsF( nameFont ).horizontalAdvance( name )
+            + QFontMetricsF( sizeFont ).horizontalAdvance( size ) + 12;
+        painter->setPen( colour );
+        // A narrow half keeps its size, which is what people are setting.
+        if ( needed <= text.width() )
+        {
+            painter->setFont( nameFont );
+            painter->drawText( text, Qt::AlignLeft | Qt::AlignVCenter, name );
+        }
+        painter->setFont( sizeFont );
+        painter->drawText(
+            text, ( needed <= text.width() ? Qt::AlignRight : Qt::AlignHCenter ) | Qt::AlignVCenter, size );
+    };
+    drawHalf( QRectF( 0, 0, split, FOCUSED_HEIGHT ),
+              m_focusLeft,
+              m_itemToResize.size,
+              QColor( 0xee, 0xf1, 0xf8 ),
+              QFont::Normal );
+    drawHalf( QRectF( split + FOCUSED_GAP, 0, width() - split - FOCUSED_GAP, FOCUSED_HEIGHT ),
+              m_focusRight,
+              m_itemToResizeNext.size,
+              QColor( 0x0f, 0x15, 0x30 ),
+              QFont::Medium );
+    painter->setClipping( false );
+
+    painter->setPen( Qt::NoPen );
+    painter->setBrush( QColor( 0, 0, 0, 90 ) );
+    painter->drawRoundedRect( handle.translated( 0, 2 ).adjusted( -1, -1, 1, 1 ), 7, 7 );
+    painter->setBrush( Qt::white );
+    painter->drawRoundedRect( handle, 6, 6 );
+    if ( hasFocus() )
+    {
+        painter->setPen( QPen( QColor( 0x8f, 0xb4, 0xff ), 2 ) );
+        painter->setBrush( Qt::NoBrush );
+        painter->drawRoundedRect( handle.adjusted( -3, -3, 3, 3 ), 8, 8 );
+    }
+}

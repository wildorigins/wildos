+namespace
+{
+/// Stops the install before any disk is touched.
+class StopJob : public Calamares::Job
+{
+public:
+    explicit StopJob( const QString& message )
+        : m_message( message )
+    {
+    }
+    QString prettyName() const override { return m_message; }
+    Calamares::JobResult exec() override { return Calamares::JobResult::error( m_message ); }
+
+private:
+    QString m_message;
+};
+}  // namespace
+
 Calamares::JobList
 PartitionViewStep::jobs() const
 {
+    // With luksPassphraseFrom set, every encrypted partition the pages made
+    // has a placeholder passphrase (see EncryptWidget). The page that asks
+    // for the disk password has stored it by now, because every page is done
+    // before the jobs are collected. Its key wildosEncrypt says whether to
+    // encrypt at all: if not, those partitions lose their LUKS layer and keep
+    // the file system that was inside.
+    //
+    // jobs() runs for the summary page and again for the install, and people
+    // can go back to the Encryption page in between, so the partitions are
+    // remembered the first time and brought in line with the answers every
+    // time: a new password, encryption turned off, or back on.
+    auto* gs = Calamares::JobQueue::instance()->globalStorage();
+    const QString passphraseKey = gs->value( "luksPassphraseFrom" ).toString();
+    if ( !passphraseKey.isEmpty() )
+    {
+        const QString placeholder = EncryptWidget::placeholderPassphrase();
+        const bool encrypt = !gs->contains( "wildosEncrypt" ) || gs->value( "wildosEncrypt" ).toBool();
+        const QString password = Calamares::String::obscure( gs->value( passphraseKey ).toString() );
+        int count = 0;
+        const auto* devices = m_core->deviceModel();
+        for ( int row = 0; row < devices->rowCount(); ++row )
+        {
+            Device* device = devices->deviceForIndex( devices->index( row ) );
+            for ( auto it = Calamares::Partition::PartitionIterator::begin( device );
+                  it != Calamares::Partition::PartitionIterator::end( device );
+                  ++it )
+            {
+                Partition* partition = *it;
+                auto* luks = dynamic_cast< FS::luks* >( &partition->fileSystem() );
+                if ( luks && luks->passphrase() == placeholder )
+                {
+                    m_passphraseLater.insert( partition );
+                }
+                if ( !m_passphraseLater.contains( partition ) )
+                {
+                    continue;
+                }
+                count++;
+                if ( encrypt && luks )
+                {
+                    luks->setPassphrase( password );
+                }
+                else if ( encrypt )
+                {
+                    // Turned off on an earlier pass, and on again.
+                    const FileSystem::Type inner = partition->fileSystem().type();
+                    const QString label = partition->fileSystem().label();
+                    auto* wrapped = dynamic_cast< FS::luks* >(
+                        FileSystemFactory::create( KPMHelpers::luksGenerationToFSName( m_config->luksFileSystemType() ),
+                                                   partition->firstSector(),
+                                                   partition->lastSector(),
+                                                   device->logicalSize() ) );
+                    if ( wrapped )
+                    {
+                        wrapped->createInnerFileSystem( inner );
+                        wrapped->setPassphrase( password );
+                        wrapped->setLabel( label );
+                        partition->deleteFileSystem();
+                        partition->setFileSystem( wrapped );
+                        partition->setRoles( PartitionRole( partition->roles().roles() | PartitionRole::Luks ) );
+                    }
+                }
+                else if ( luks )
+                {
+                    const FileSystem::Type inner = luks->innerFS() ? luks->innerFS()->type() : FileSystem::Ext4;
+                    const QString label = luks->label();
+                    partition->deleteFileSystem();
+                    FileSystem* plain = FileSystemFactory::create(
+                        inner, partition->firstSector(), partition->lastSector(), device->logicalSize() );
+                    plain->setLabel( label );
+                    partition->setFileSystem( plain );
+                    partition->setRoles( PartitionRole( partition->roles().roles() & ~PartitionRole::Luks ) );
+                }
+            }
+        }
+        if ( count > 0 && encrypt )
+        {
+            if ( password.isEmpty() )
+            {
+                return { Calamares::job_ptr(
+                    new StopJob( tr( "There is no disk password to lock the disk with.", "@info" ) ) ) };
+            }
+            gs->insert( "luksPassphrase", gs->value( passphraseKey ) );
+        }
+        else
+        {
+            gs->insert( "luksPassphrase", QString() );
+        }
+        cDebug() << "Disk passphrase for" << count << "partitions:" << ( encrypt ? "set" : "not encrypting" );
+    }
     return m_core->jobs( m_config );
 }
 

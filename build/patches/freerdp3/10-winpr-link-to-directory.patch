Description: A link to a directory is a directory again
 FreeRDP 3.33 made GetFileAttributes look at a symbolic link itself, so a
 link to a directory lost FILE_ATTRIBUTE_DIRECTORY and the drive channel
 refused to open it ("The directory name is invalid"). Windows mode's
 shared drive is a folder of links to the person's own folders, so none of
 them opened in Windows. This is upstream's own fix (FreeRDP pull request
 14145, merged 11 November 2026): the target decides whether it is a
 directory, and a link still carries FILE_ATTRIBUTE_REPARSE_POINT.
 Drop it once Debian ships a FreeRDP release with that change.
Author: Wild OS Developers <dev@wildos.io>
Origin: upstream, https://github.com/FreeRDP/FreeRDP/pull/14145
Forwarded: not-needed

--- a/winpr/libwinpr/file/generic.c
+++ b/winpr/libwinpr/file/generic.c
@@ -538,7 +538,7 @@ BOOL WINAPI GetFileAttributesExW(LPCWSTR lpFileName, GET_FILEEX_INFO_LEVELS fInf
 DWORD WINAPI GetFileAttributesA(LPCSTR lpFileName)
 {
 	struct stat fileStat = WINPR_C_ARRAY_INIT;
-	if (lstat(lpFileName, &fileStat) != 0)
+	if (stat(lpFileName, &fileStat) != 0)
 		return INVALID_FILE_ATTRIBUTES;

 	return FileAttributesFromStat(lpFileName, &fileStat);
@@ -1168,9 +1168,13 @@ static DWORD FileAttributesFromStat(const char* path, const struct stat* fileSta
 	if (!(fileStat->st_mode & S_IWUSR))
 		dwFileAttributes |= FILE_ATTRIBUTE_READONLY;

-	if (S_ISLNK(fileStat->st_mode))
-		dwFileAttributes |= FILE_ATTRIBUTE_REPARSE_POINT;
-
+	struct stat lFileStat = WINPR_C_ARRAY_INIT;
+	const int rc = lstat(path, &lFileStat);
+	if (rc == 0)
+	{
+		if (S_ISLNK(lFileStat.st_mode))
+			dwFileAttributes |= FILE_ATTRIBUTE_REPARSE_POINT;
+	}
 	return dwFileAttributes;
 }


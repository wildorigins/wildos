#!/usr/bin/make -f

%:
	dh $@

# Installed as /etc/pam.d/kde and kde-fingerprint; kept as pam-kde* in the
# source so they are not mistaken for KDE files.
execute_after_dh_install:
	mv debian/wildos-desktop/etc/pam.d/pam-kde debian/wildos-desktop/etc/pam.d/kde
	mv debian/wildos-desktop/etc/pam.d/pam-kde-fingerprint debian/wildos-desktop/etc/pam.d/kde-fingerprint
	# Brave: what is switched off and the default search engine (policies;
	# the search one is recommended, so people can change it), and the
	# launcher.
	install -Dm644 files/brave/managed.json debian/wildos-desktop/etc/brave/policies/managed/wildos.json
	install -Dm644 files/brave/recommended.json debian/wildos-desktop/etc/brave/policies/recommended/wildos.json
	install -Dm755 files/brave/brave-browser-stable debian/wildos-desktop/usr/bin/brave-browser-stable
	# Sponsored new tab backgrounds have no policy, only a preference, so
	# every new profile starts with them off. Brave reads this file from
	# beside its own binary and ships none of its own.
	install -Dm644 files/brave/initial_preferences debian/wildos-desktop/opt/brave.com/brave/initial_preferences
	# Started with every boot without needing systemctl enable.
	mkdir -p debian/wildos-desktop/usr/lib/systemd/system/graphical.target.wants
	ln -sf ../wildos-brave-gpu.service debian/wildos-desktop/usr/lib/systemd/system/graphical.target.wants/wildos-brave-gpu.service

execute_after_dh_fixperms:
	chmod 0755 debian/wildos-desktop/usr/libexec/wildos/wildos-app-names \
		debian/wildos-desktop/usr/libexec/wildos/wildos-strings \
		debian/wildos-desktop/usr/libexec/wildos/update-checks \
		debian/wildos-desktop/usr/libexec/wildos/fingerprint-turn \
		debian/wildos-desktop/usr/bin/brave-browser-stable 		debian/wildos-desktop/usr/libexec/wildos/brave-gpu 		debian/wildos-desktop/usr/libexec/wildos/brave-gpu-policy \
		debian/wildos-desktop/usr/lib/systemd/user-environment-generators/60-wildos-kpipewire-encoder

 kinfocenter,
 kde-config-gtk-style,
 breeze-gtk-theme,
 pipewire-audio,
 pipewire-pulse,
# The start-up sound (wildos-branding) is played by startplasma through
# libcanberra. Without this backend libcanberra falls back to ALSA, whose
# player thread can still be running in libcanberra-alsa.so after it
# reports the sound finished; startplasma then frees the context, the
# module is unloaded under the thread, and the whole session crashes back
# to the sign-in screen about 6 seconds in. The PulseAudio backend, served
# by pipewire-pulse, stops its thread before the context goes.
 libcanberra-pulse,
 wireplumber,
 fonts-noto-core,
 fonts-noto-color-emoji,
 usbguard-notifier,
# AppImages mount themselves with FUSE 2, which Debian no longer installs
# for anything else since the image left out Recommends (plasma-vault
# brought it in before). fuse3 already gives them fusermount.
 libfuse2t64,
 python3,
 xdg-user-dirs,
# kwalletd's Secret Service (secret-tool, Brave, Windows mode's keyring)
# needs QCA's OpenSSL plugin for its encrypted sessions, and without it
# every libsecret call fails. QCA only recommends it, and recommends are
# not installed.
 libqca-qt6-plugins,
# Fingerprint readers: fprintd talks to the reader, and the PAM module lets
# the sign-in screen, the lock screen, sudo and administrator prompts take
# a finger (see files/pam-configs/wildos-fingerprint).
 fprintd,
 libpam-fprintd,
# KDE Connect opens network ports for phone pairing, which a security-focused
# system should not do unasked; Konqueror would be a second browser; Kup is a
# backup tray app that sits in the bar. desktop-base is Debian's artwork
# (boot splash, user picture, login background) and would compete with Wild
# OS's. xwaylandvideobridge puts a "Wayland to X11 Video Bridge" window and
# tray icon on screen whenever an older app shares the screen. People can
# install any of the apps from the Store.
Conflicts:
 kdeconnect,
 konqueror,
 kup-backup,
 lxqt-notificationd,
 desktop-base,
 sddm-theme-debian-breeze,
 xwaylandvideobridge,
# Wild OS's own apps are recommended, not required: each can be uninstalled
# from Settings or the Store without taking the desktop with it, and put back
# from the Store. The image installs them all, and apt never
# brings one back on its own once it has been removed.
Recommends:
 wildos-mail,
 wildos-write,
 wildos-tables,
 wildos-remote,

#!/bin/sh
set -e

DISABLED=/usr/share/wildos/autostart-disabled
AUTOSTART="
legacy-dist-deprecation-notice.desktop
msgdispatcher.desktop
systemcheck.desktop
updatecheck.desktop
sdwdate-gui.desktop
wlr-resize-watcher.desktop
config-mnt-shared-bookmark.desktop
"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for f in $AUTOSTART; do
        dpkg-divert --package wildos-desktop --remove --rename \
            --divert "$DISABLED/$f" "/etc/xdg/autostart/$f" >/dev/null || true
    done
    rmdir "$DISABLED" 2>/dev/null || true
    dpkg-divert --package wildos-desktop --remove --rename \
        --divert /usr/bin/brave-browser-stable.brave /usr/bin/brave-browser-stable >/dev/null || true
    dpkg-divert --package wildos-desktop --remove --rename \
        --divert /usr/share/wildos/diverted/plasma-xdg-desktop-portal-kde.service \
        /usr/lib/systemd/user/plasma-xdg-desktop-portal-kde.service >/dev/null || true
    rmdir /usr/share/wildos/diverted 2>/dev/null || true
    # Written by wildos-strings, so dpkg does not know about them.
    rm -rf /usr/share/wildos/locale
    # Written by brave-gpu-policy.
    rm -f /etc/brave/policies/managed/wildos-graphics.json /etc/opt/chrome/policies/managed/wildos-graphics.json /etc/chromium/policies/managed/wildos-graphics.json
fi

#DEBHELPER#

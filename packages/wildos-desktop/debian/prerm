#!/bin/sh
set -e

# Takes fingerprint and PIN sign-in out of common-auth while their PAM
# profiles and fingerprint-turn are still on disk.
if [ "$1" = "remove" ] && command -v pam-auth-update >/dev/null; then
    pam-auth-update --package --remove wildos-fingerprint wildos-fingerprint-stamp wildos-pin
fi

#DEBHELPER#

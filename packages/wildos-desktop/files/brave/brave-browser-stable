#!/bin/sh
# Brave as Wild OS starts it: videos decode on the graphics chip where it can
# (VA-API through OpenGL, the path Chromium uses on Wayland), falling back to
# the processor where it can't. Installed over Brave's own link by a dpkg
# diversion (wildos-desktop's postinst), so a Brave update keeps it.

# Screens on an NVIDIA card running the open nouveau driver: no graphics
# acceleration (brave-gpu says why). wildos-brave-gpu.service also sets it as
# a policy, for the ways of starting Brave that skip this launcher.

# A typing method such as Vietnamese Telex runs through Fcitx 5 as KWin's input
# method, which Chromium only talks to with these switches.
ime=
if grep -qs '^InputMethod=.*org\.fcitx\.Fcitx5\.desktop' "${XDG_CONFIG_HOME:-$HOME/.config}/kwinrc"; then
    ime="--enable-wayland-ime --wayland-text-input-version=3"
fi

if [ "$(/usr/libexec/wildos/brave-gpu)" = off ]; then
    # shellcheck disable=SC2086
    exec /opt/brave.com/brave/brave-browser --disable-gpu $ime "$@"
fi
# shellcheck disable=SC2086
exec /opt/brave.com/brave/brave-browser \
    --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL $ime "$@"

[Unit]
Description=Wild OS lighting: the taskbar underglow's colours, or the effects chosen in Cooler, on this PC's lights
PartOf=graphical-session.target
After=graphical-session.target
# Debian trixie has no OpenRGB package; without one installed there is
# nothing to light.
ConditionFileIsExecutable=/usr/bin/openrgb

[Service]
Type=exec
ExecStart=/usr/libexec/wildos/wildos-lighting
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target

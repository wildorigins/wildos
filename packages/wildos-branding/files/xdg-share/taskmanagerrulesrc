# Plasma's own rules, plus apps whose window names a different app than
# their Start entry, so the taskbar shows the app's icon and pins match.
[Mapping]
Gimp-2.8=GIMP
Gimp-2.10=GIMP
Gimp-2.12=GIMP
Google-chrome=Google Chrome
Google-chrome-stable=Google Chrome
Systemsettings=System Settings
oracle-ide-boot-Launcher=Oracle SQL Developer
Dragon=dragonplayer
VirtualBox Manager=virtualbox
VirtualBox Machine=virtualbox
ai.elementlabs.lmstudio=ai.lmstudio.lm-studio

[Settings]
MatchCommandLineFirst=perl
TryIgnoreRuntimes=perl
SkipTaskbar=Soffice

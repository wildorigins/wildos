# The Wild OS Aurorae decoration draws the design's 42px title bar, thin
# glyphs, calm red close and 14px corners, which Breeze cannot be configured
# to do. Breeze settings in breezerc remain as the fallback.
# Windows order: minimise, maximise, close on the right, nothing on the left.
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__WildOS
# Tiny is the size at which Aurorae uses the theme's own 1px glass edge.
BorderSize=Tiny
BorderSizeAuto=false
ButtonsOnLeft=
ButtonsOnRight=IAX
# Breeze's own "Maximize" tooltip would land on top of the snap layout picker
# that appears when hovering the maximise button.
ShowToolTips=false

[Plugins]
blurEnabled=true
contrastEnabled=true
org.wildos.snapEnabled=true
org.wildos.launchEnabled=true
# The taskbar's peek fades the windows out where they stand, as on Windows,
# instead of sliding them off to the screen edges. Both effects animate
# showing the desktop, so only one may run.
windowapertureEnabled=false
org.wildos.peekfadeEnabled=true
# wildos-shell's fade between the old and new colours when the theme or
# accent changes takes the place of KWin's, which flashed a darker shadow
# round each window. Both answer the same D-Bus call, so only one may run.
blendchangesEnabled=false

# Mica, as on Windows 11: the wallpaper behind glass is blurred until no shapes
# show, only a soft gradient of its colours, under a mostly opaque tint
# (WildOS.UI's Style). The contrast effect above adds Mica's slight lift in
# saturation. KWin's noise would show as grain on the smooth gradient.
[Effect-blur]
BlurStrength=12
NoiseStrength=0

# The Wild OS window switcher, with a plain dim behind it instead of KWin
# fading the other windows.
[TabBox]
LayoutName=org.wildos.switcher
HighlightWindows=false

# Window open and close, as on Windows 11: a short fade with a slight grow
# from 94% as a window arrives and a slight shrink to 96% as it goes, in
# 200 ms (UI.Style.motionNormal). KWin's own 80% reads as a zoom.
[Effect-scale]
Duration=200
InScale=0.94
OutScale=0.96

# Start, the flyouts and the volume pill rise from the taskbar on KWin's
# sliding pop-ups. They arrive in 200 ms and leave a little quicker, as
# Windows flyouts do.
[Effect-slidingpopups]
SlideInTime=200
SlideOutTime=150

# Older (X11) apps may not see what is typed into other apps unless the
# person allows it in Settings > Apps > Old app compatibility. KWin's own
# default lets them see keys pressed with Ctrl, Alt or the Windows key.
[Xwayland]
XwaylandEavesdrops=None
XwaylandEavesdropsMouse=false

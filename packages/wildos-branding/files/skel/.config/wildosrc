# Hot corners for new accounts (Settings > Multitasking). Every corner does
# nothing until chosen, as on Windows, since a corner that fires on its own
# is easy to set off by accident. Accounts made before hot corners had these
# keep the corners they had: KWin's wildos_hotcorners plugin copies them over
# once.
[HotCorners]
TopLeft=none
TopRight=none
BottomLeft=none
BottomRight=none

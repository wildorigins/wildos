[Unit]
Description=Wild OS system dialogs (Open, Save and file clashes)
PartOf=graphical-session.target
# Only the compositor is needed. Waiting for the graphical session would wait
# for the desktop, and the desktop asks the portal for its settings while it
# starts: the two waited on each other until a 25 second timeout gave way.
After=plasma-kwin_wayland.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.wildos
ExecStart=/usr/libexec/wildos/wildos-portal
Slice=session.slice

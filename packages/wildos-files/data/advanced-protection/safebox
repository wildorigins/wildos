#!/bin/sh
# Advanced protection: Safe box (safebox). Run as root by
# advanced-protection-apply with the new value, on or off. Files reads the
# switch from /etc/wildos/advanced-protection and offers Open in safe box
# only while it is on, so there is nothing system-wide to change here. This
# file being here is what puts the row on the Settings page.
case "${1:-}" in
    on|off) exit 0 ;;
    *) echo "usage: safebox on|off" >&2; exit 2 ;;
esac

#!/usr/bin/python3 -I
"""What happened on this PC, for Settings > System > History.

Runs as root, from wildos-history.timer every hour and from
wildos-history.socket whenever Settings opens the page, and takes no
requests: it only reads. It picks out the events a person would care about
from the system journal, apt's history, the restore points' index and the
firewall's list of blocked connections, and keeps them as plain records:

    /var/lib/wildos/history/system.jsonl      what anyone on this PC may see
    /var/lib/wildos/history/user-UID.jsonl    one account's own, readable
                                              by that account only

Each line is one event: {id, t, kind, data, tech}, tech being the few
source lines it was made from. Settings writes the words. Events older
than 30 days are deleted on every run, and nothing is sent anywhere.

    settings-history collect      bring the records up to date
    settings-history serve        the same for one connection on standard
                                  input (wildos-history@.service), answering
                                  "ok" or "error <why>"
    settings-history lid-closed   note what decides the lid's action as it
                                  closes (wildos-network runs it then)
    settings-history lid-opened   note the lid opening (the same)
    settings-history forget firewall
                                  the firewall's Clear the list: drop
                                  History's copies of what it blocked
"""

import fcntl
import glob
import hashlib
import json
import os
import pwd
import re
import subprocess
import sys
import time

DIR = "/var/lib/wildos/history"
STATE = os.path.join(DIR, "state.json")
LOCK = "/run/wildos-history.lock"
KEEP = 30 * 24 * 3600
# Repeats of the same thing this close together are one event.
MERGE = 10 * 60

APT_LOGS = ["/var/log/apt/history.log.1", "/var/log/apt/history.log"]
FIREWALL_LOG = "/var/lib/wildos/firewall/blocked.log"
RESTORE_INDEXES = ["/.snapshots/index.json", "/var/lib/wildos/restore-points/index.json"]

RESTORE_LOGS = ["/var/log/wildos-restore-points.log.1", "/var/log/wildos-restore-points.log"]
# What wildos-network writes when the lid closes: why nothing may happen
# next, which the journal never says (lid-closed below).
LID_SNAPSHOTS = os.path.join(DIR, "lid-snapshots.json")
# The lid closed and nothing followed within this long: it stayed on.
LID_WAIT = 90
# The label restore-points gives the point Reset Wild OS makes first.
RESET_LABEL = "Before resetting Wild OS"

COREDUMP = "fc2e22bc6ee647b6b90729ab34a250b1"
SESSION_START = "8d45620c1a4348dbb17410da57c60c66"
SESSION_STOP = "3354939424b4456d9802ca8333ed424a"
FLATPAK = "c7b39b1e006b464599465e105b361485"
SLEEP_START = "6bbd95ee977941e497c48be27c254128"
SLEEP_STOP = "8811e6df2a8e40f58a94cea26f8ebf14"
# logind: "The system will reboot now!" with ACTION and OPERATOR, then
# "System is rebooting." with SHUTDOWN.
LOGIND_ASKED = "9e7066279dc8403da79ce4b1a69064b2"
LOGIND_SHUTDOWN = "98268866d1d54a499c4e98921d93bc40"
STARTUP_FINISHED = "b07a249cd024414a82dd00cd181378ff"
JOURNAL_STOPPED = "d93fb3c9c24d451a97cea615ce59c00b"

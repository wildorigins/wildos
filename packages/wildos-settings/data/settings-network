#!/bin/sh
# Turns the VPN kill switch on or off for Settings > Network and internet >
# Advanced network settings. Runs as root through pkexec
# (org.wildos.settings.policy) and takes only the requests below.
#
#   kill-switch on    Block the internet whenever a VPN that was connected
#                     drops, until it reconnects or is switched off.
#   kill-switch off   Stop blocking.
#
# The same switch is Advanced protection's "Block everything unless the VPN
# is on", so the choice goes into its store and its vpn_only hook writes
# /etc/wildos/vpn-kill-switch, which the wildos-network service watches.

set -eu

case "${1:-} ${2:-}" in
    "kill-switch on" | "kill-switch off")
        exec /usr/libexec/wildos/settings-advanced set vpn_only "$2"
        ;;
    *)
        echo "usage: settings-network kill-switch on|off" >&2
        exit 2
        ;;
esac

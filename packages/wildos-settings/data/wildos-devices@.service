[Unit]
Description=Settings > System > Devices: firmware and drive health
Documentation=file:///usr/libexec/wildos/settings-devices

[Service]
Type=oneshot
ExecStart=/usr/libexec/wildos/settings-devices
StandardInput=socket
StandardOutput=socket
StandardError=journal
Nice=10
ProtectHome=yes
PrivateNetwork=yes
NoNewPrivileges=yes

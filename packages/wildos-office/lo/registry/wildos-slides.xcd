<?xml version="1.0" encoding="UTF-8"?>
<!-- Wild OS defaults for Slides: the settings that only exist with LibreOffice Impress
     installed. Shipped by wildos-slides, which requires it; wildos.xcd holds the rest. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <dependency file="impress"/>

  <oor:component-data oor:package="org.openoffice" oor:name="Setup">
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <prop oor:name="ooSetupFactoryWindowAttributes"><value>,,,;4;</value></prop>
          <prop oor:name="ooSetupFactoryDefaultFilter"><value>Impress MS PowerPoint 2007 XML</value></prop>
          <prop oor:name="ooSetupFactoryUIName"><value xml:lang="en-US">Slides</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- Alt+Q opens Find a command, as in Word; the search field shows it. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Accelerators">
    <node oor:name="PrimaryKeys">
      <node oor:name="Modules">
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <node oor:name="Q_MOD2" oor:op="replace">
            <prop oor:name="Command"><value xml:lang="en-US">.uno:CommandPopup</value></prop>
          </node>
        </node>
      </node>
    </node>
  </oor:component-data>

  <!-- No tool bars under the ribbon, as in Write and Tables. Impress shows its
       own (drawing, text, table...) whenever its saved state says they are
       visible, ribbon or not, so they start hidden here: the state LibreOffice
       itself saves when someone switches to a ribbon. Classic menus and
       toolbars, in View, brings them back. -->
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ImpressWindowState">
    <node oor:name="UIElements">
      <node oor:name="States">
        <node oor:name="private:resource/toolbar/extrusionobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/commontaskbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/formtextobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/formsfilterbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/formsnavigationbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/fontworkobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/outlinetoolbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/slideviewobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/standardbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/textobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/toolbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/tableobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/gluepointsobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/bezierobjectbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/viewerbar"><prop oor:name="Visible"><value>false</value></prop></node>
        <node oor:name="private:resource/toolbar/masterviewtoolbar"><prop oor:name="Visible"><value>false</value></prop></node>
      </node>
    </node>
  </oor:component-data>

  <!-- The presenter's own screen during a show, as on Slides board 12.20: a top
       bar with the file name, slide count, timer and clock; the slide on screen
       large on the left under ON SCREEN NOW; NEXT and NOTES on the right; and
       along the bottom Back, Next, Pointer, Pen, Black screen, a strip of slide
       thumbnails and End show. Listing the TopBar view is what makes the Wild OS
       LibreOffice arrange it this way; the pieces themselves are its own. -->
  <oor:component-data oor:package="org.openoffice.Office" oor:name="PresenterScreen">
    <node oor:name="PresenterScreenSettings">
    <node oor:name="ToolBars">
      <node oor:name="ToolBar" oor:op="replace">
        <node oor:name="Entries">
          <node oor:name="wa" oor:op="replace">
            <prop oor:name="Name"><value>PillBack</value></prop>
            <prop oor:name="Type"><value>Button</value></prop>
            <node oor:name="Normal">
              <prop oor:name="Text"><value xml:lang="en-US">Back</value><value xml:lang="fr">Précédente</value><value xml:lang="nl">Terug</value><value xml:lang="de">Zurück</value><value xml:lang="es">Atrás</value><value xml:lang="it">Indietro</value><value xml:lang="pt">Anterior</value><value xml:lang="pl">Wstecz</value><value xml:lang="ar">السابقة</value><value xml:lang="cs">Zpět</value><value xml:lang="el">Πίσω</value><value xml:lang="hi">पीछे</value><value xml:lang="hu">Vissza</value><value xml:lang="id">Kembali</value><value xml:lang="ja">戻る</value><value xml:lang="ko">뒤로</value><value xml:lang="pt-BR">Voltar</value><value xml:lang="ro">Înapoi</value><value xml:lang="ru">Назад</value><value xml:lang="sv">Bakåt</value><value xml:lang="tr">Geri</value><value xml:lang="uk">Назад</value><value xml:lang="vi">Quay lại</value><value xml:lang="zh-CN">上一步</value><value xml:lang="zh-TW">上一步</value><value xml:lang="nb">Tilbake</value><value xml:lang="da">Tilbage</value><value xml:lang="fi">Takaisin</value><value xml:lang="th">ย้อนกลับ</value><value xml:lang="ms">Kembali</value><value xml:lang="fil">Bumalik</value><value xml:lang="bn">পিছনে</value><value xml:lang="ta">பின்செல்</value><value xml:lang="te">వెనుకకు</value><value xml:lang="mr">मागे</value><value xml:lang="sk">Späť</value><value xml:lang="bg">Назад</value><value xml:lang="hr">Natrag</value><value xml:lang="sr">Назад</value><value xml:lang="sl">Nazaj</value><value xml:lang="lt">Atgal</value><value xml:lang="lv">Atpakaļ</value><value xml:lang="et">Tagasi</value><value xml:lang="ca">Enrere</value></prop>
              <node oor:name="Icon"><prop oor:name="NormalFileName"><value>bitmaps/WildOSBack.png</value></prop></node>
              <prop oor:name="Action"><value>vnd.org.libreoffice.presenterscreen:PrevSlide</value></prop>
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>14</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
          <node oor:name="wb" oor:op="replace">
            <prop oor:name="Name"><value>PillNext</value></prop>
            <prop oor:name="Type"><value>Button</value></prop>
            <node oor:name="Normal">
              <prop oor:name="Text"><value xml:lang="en-US">Next</value><value xml:lang="fr">Suivante</value><value xml:lang="nl">Volgende</value><value xml:lang="de">Weiter</value><value xml:lang="es">Siguiente</value><value xml:lang="it">Avanti</value><value xml:lang="pt">Seguinte</value><value xml:lang="pl">Dalej</value><value xml:lang="ar">التالية</value><value xml:lang="cs">Další</value><value xml:lang="el">Επόμενη</value><value xml:lang="hi">आगे</value><value xml:lang="hu">Tovább</value><value xml:lang="id">Berikutnya</value><value xml:lang="ja">次へ</value><value xml:lang="ko">다음</value><value xml:lang="pt-BR">Avançar</value><value xml:lang="ro">Următorul</value><value xml:lang="ru">Далее</value><value xml:lang="sv">Nästa</value><value xml:lang="tr">İleri</value><value xml:lang="uk">Далі</value><value xml:lang="vi">Tiếp theo</value><value xml:lang="zh-CN">下一步</value><value xml:lang="zh-TW">下一步</value><value xml:lang="nb">Neste</value><value xml:lang="da">Næste</value><value xml:lang="fi">Seuraava</value><value xml:lang="th">ถัดไป</value><value xml:lang="ms">Seterusnya</value><value xml:lang="fil">Susunod</value><value xml:lang="bn">পরবর্তী</value><value xml:lang="ta">அடுத்து</value><value xml:lang="te">తదుపరి</value><value xml:lang="mr">पुढील</value><value xml:lang="sk">Ďalej</value><value xml:lang="bg">Напред</value><value xml:lang="hr">Sljedeće</value><value xml:lang="sr">Следеће</value><value xml:lang="sl">Naprej</value><value xml:lang="lt">Kitas</value><value xml:lang="lv">Tālāk</value><value xml:lang="et">Edasi</value><value xml:lang="ca">Següent</value></prop>
              <node oor:name="Icon"><prop oor:name="NormalFileName"><value>bitmaps/WildOSNext.png</value></prop></node>
              <prop oor:name="Action"><value>vnd.org.libreoffice.presenterscreen:NextSlide</value></prop>
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>14</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
          <node oor:name="wc" oor:op="replace">
            <prop oor:name="Name"><value>PillPointer</value></prop>
            <prop oor:name="Type"><value>Button</value></prop>
            <node oor:name="Normal">
              <prop oor:name="Text"><value xml:lang="en-US">Pointer</value><value xml:lang="fr">Pointeur</value><value xml:lang="nl">Aanwijzer</value><value xml:lang="de">Zeiger</value><value xml:lang="es">Puntero</value><value xml:lang="it">Puntatore</value><value xml:lang="pt">Ponteiro</value><value xml:lang="pl">Wskaźnik</value><value xml:lang="ar">المؤشر</value><value xml:lang="cs">Ukazatel</value><value xml:lang="el">Δείκτης</value><value xml:lang="hi">पॉइंटर</value><value xml:lang="hu">Mutató</value><value xml:lang="id">Penunjuk</value><value xml:lang="ja">ポインター</value><value xml:lang="ko">포인터</value><value xml:lang="pt-BR">Ponteiro</value><value xml:lang="ro">Indicator</value><value xml:lang="ru">Указка</value><value xml:lang="sv">Pekare</value><value xml:lang="tr">İşaretçi</value><value xml:lang="uk">Вказівник</value><value xml:lang="vi">Con trỏ</value><value xml:lang="zh-CN">指针</value><value xml:lang="zh-TW">指標</value><value xml:lang="nb">Peker</value><value xml:lang="da">Markør</value><value xml:lang="fi">Osoitin</value><value xml:lang="th">ตัวชี้</value><value xml:lang="ms">Penuding</value><value xml:lang="fil">Pointer</value><value xml:lang="bn">পয়েন্টার</value><value xml:lang="ta">சுட்டி</value><value xml:lang="te">పాయింటర్</value><value xml:lang="mr">पॉइंटर</value><value xml:lang="sk">Ukazovateľ</value><value xml:lang="bg">Показалец</value><value xml:lang="hr">Pokazivač</value><value xml:lang="sr">Показивач</value><value xml:lang="sl">Kazalec</value><value xml:lang="lt">Žymeklis</value><value xml:lang="lv">Rādītājs</value><value xml:lang="et">Osuti</value><value xml:lang="ca">Punter</value></prop>
              <node oor:name="Icon"><prop oor:name="NormalFileName"><value>bitmaps/WildOSPointer.png</value></prop></node>
              <prop oor:name="Action"><value>vnd.org.libreoffice.presenterscreen:UsePointer</value></prop>
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>14</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
          <node oor:name="wd" oor:op="replace">
            <prop oor:name="Name"><value>PillPen</value></prop>
            <prop oor:name="Type"><value>Button</value></prop>
            <node oor:name="Normal">
              <prop oor:name="Text"><value xml:lang="en-US">Pen</value><value xml:lang="fr">Stylo</value><value xml:lang="nl">Pen</value><value xml:lang="de">Stift</value><value xml:lang="es">Lápiz</value><value xml:lang="it">Penna</value><value xml:lang="pt">Caneta</value><value xml:lang="pl">Pióro</value><value xml:lang="ar">القلم</value><value xml:lang="cs">Pero</value><value xml:lang="el">Στυλό</value><value xml:lang="hi">पेन</value><value xml:lang="hu">Toll</value><value xml:lang="id">Pena</value><value xml:lang="ja">ペン</value><value xml:lang="ko">펜</value><value xml:lang="pt-BR">Caneta</value><value xml:lang="ro">Stilou</value><value xml:lang="ru">Перо</value><value xml:lang="sv">Penna</value><value xml:lang="tr">Kalem</value><value xml:lang="uk">Перо</value><value xml:lang="vi">Bút</value><value xml:lang="zh-CN">笔</value><value xml:lang="zh-TW">筆</value><value xml:lang="nb">Penn</value><value xml:lang="da">Pen</value><value xml:lang="fi">Kynä</value><value xml:lang="th">ปากกา</value><value xml:lang="ms">Pen</value><value xml:lang="fil">Panulat</value><value xml:lang="bn">কলম</value><value xml:lang="ta">பேனா</value><value xml:lang="te">పెన్</value><value xml:lang="mr">पेन</value><value xml:lang="sk">Pero</value><value xml:lang="bg">Писалка</value><value xml:lang="hr">Olovka</value><value xml:lang="sr">Оловка</value><value xml:lang="sl">Pisalo</value><value xml:lang="lt">Rašiklis</value><value xml:lang="lv">Pildspalva</value><value xml:lang="et">Pastakas</value><value xml:lang="ca">Bolígraf</value></prop>
              <node oor:name="Icon"><prop oor:name="NormalFileName"><value>bitmaps/WildOSPen.png</value></prop></node>
              <prop oor:name="Action"><value>vnd.org.libreoffice.presenterscreen:UsePen</value></prop>
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>14</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
          <node oor:name="we" oor:op="replace">
            <prop oor:name="Name"><value>PillBlack</value></prop>
            <prop oor:name="Type"><value>Button</value></prop>
            <node oor:name="Normal">
              <prop oor:name="Text"><value xml:lang="en-US">Black screen</value><value xml:lang="fr">Écran noir</value><value xml:lang="nl">Zwart scherm</value><value xml:lang="de">Schwarzer Bildschirm</value><value xml:lang="es">Pantalla en negro</value><value xml:lang="it">Schermo nero</value><value xml:lang="pt">Ecrã preto</value><value xml:lang="pl">Czarny ekran</value><value xml:lang="ar">شاشة سوداء</value><value xml:lang="cs">Černá obrazovka</value><value xml:lang="el">Μαύρη οθόνη</value><value xml:lang="hi">काली स्क्रीन</value><value xml:lang="hu">Fekete képernyő</value><value xml:lang="id">Layar hitam</value><value xml:lang="ja">黒い画面</value><value xml:lang="ko">검은 화면</value><value xml:lang="pt-BR">Tela preta</value><value xml:lang="ro">Ecran negru</value><value xml:lang="ru">Чёрный экран</value><value xml:lang="sv">Svart skärm</value><value xml:lang="tr">Siyah ekran</value><value xml:lang="uk">Чорний екран</value><value xml:lang="vi">Màn hình đen</value><value xml:lang="zh-CN">黑屏</value><value xml:lang="zh-TW">黑畫面</value><value xml:lang="nb">Svart skjerm</value><value xml:lang="da">Sort skærm</value><value xml:lang="fi">Musta näyttö</value><value xml:lang="th">หน้าจอสีดำ</value><value xml:lang="ms">Skrin hitam</value><value xml:lang="fil">Itim na screen</value><value xml:lang="bn">কালো স্ক্রিন</value><value xml:lang="ta">கருப்புத் திரை</value><value xml:lang="te">నల్లని స్క్రీన్</value><value xml:lang="mr">काळी स्क्रीन</value><value xml:lang="sk">Čierna obrazovka</value><value xml:lang="bg">Черен екран</value><value xml:lang="hr">Crni zaslon</value><value xml:lang="sr">Црни екран</value><value xml:lang="sl">Črn zaslon</value><value xml:lang="lt">Juodas ekranas</value><value xml:lang="lv">Melns ekrāns</value><value xml:lang="et">Must ekraan</value><value xml:lang="ca">Pantalla en negre</value></prop>
              <node oor:name="Icon"><prop oor:name="NormalFileName"><value>bitmaps/WildOSBlack.png</value></prop></node>
              <prop oor:name="Action"><value>vnd.org.libreoffice.presenterscreen:BlackScreen</value></prop>
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>14</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
        </node>
      </node>
      <node oor:name="TopBar" oor:op="replace">
        <node oor:name="Entries">
          <node oor:name="a" oor:op="replace">
            <prop oor:name="Name"><value>DocumentTitle</value></prop>
            <prop oor:name="Type"><value>Label</value></prop>
            <node oor:name="Normal">
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>15</value></prop><prop oor:name="Style"><value>Bold</value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>

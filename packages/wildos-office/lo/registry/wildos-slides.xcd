          <node oor:name="b" oor:op="replace">
            <prop oor:name="Name"><value>SlideNumber</value></prop>
            <prop oor:name="Type"><value>Label</value></prop>
            <node oor:name="Normal">
              <prop oor:name="Text"><value xml:lang="en-US">Slide %CURRENT_SLIDE_NUMBER% of %SLIDE_COUNT%</value><value xml:lang="fr">Diapositive %CURRENT_SLIDE_NUMBER% sur %SLIDE_COUNT%</value><value xml:lang="nl">Dia %CURRENT_SLIDE_NUMBER% van %SLIDE_COUNT%</value><value xml:lang="de">Folie %CURRENT_SLIDE_NUMBER% von %SLIDE_COUNT%</value><value xml:lang="es">Diapositiva %CURRENT_SLIDE_NUMBER% de %SLIDE_COUNT%</value><value xml:lang="it">Diapositiva %CURRENT_SLIDE_NUMBER% di %SLIDE_COUNT%</value><value xml:lang="pt">Diapositivo %CURRENT_SLIDE_NUMBER% de %SLIDE_COUNT%</value><value xml:lang="pl">Slajd %CURRENT_SLIDE_NUMBER% z %SLIDE_COUNT%</value><value xml:lang="ar">الشريحة %CURRENT_SLIDE_NUMBER% من %SLIDE_COUNT%</value><value xml:lang="cs">Snímek %CURRENT_SLIDE_NUMBER% z %SLIDE_COUNT%</value><value xml:lang="el">Διαφάνεια %CURRENT_SLIDE_NUMBER% από %SLIDE_COUNT%</value><value xml:lang="hi">स्लाइड %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="hu">%CURRENT_SLIDE_NUMBER%. dia, összesen: %SLIDE_COUNT%</value><value xml:lang="id">Slide %CURRENT_SLIDE_NUMBER% dari %SLIDE_COUNT%</value><value xml:lang="ja">スライド %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="ko">슬라이드 %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="pt-BR">Slide %CURRENT_SLIDE_NUMBER% de %SLIDE_COUNT%</value><value xml:lang="ro">Diapozitivul %CURRENT_SLIDE_NUMBER% din %SLIDE_COUNT%</value><value xml:lang="ru">Слайд %CURRENT_SLIDE_NUMBER% из %SLIDE_COUNT%</value><value xml:lang="sv">Bild %CURRENT_SLIDE_NUMBER% av %SLIDE_COUNT%</value><value xml:lang="tr">Slayt %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="uk">Слайд %CURRENT_SLIDE_NUMBER% із %SLIDE_COUNT%</value><value xml:lang="vi">Trang chiếu %CURRENT_SLIDE_NUMBER% trên %SLIDE_COUNT%</value><value xml:lang="zh-CN">幻灯片 %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="zh-TW">投影片 %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="nb">Lysbilde %CURRENT_SLIDE_NUMBER% av %SLIDE_COUNT%</value><value xml:lang="da">Slide %CURRENT_SLIDE_NUMBER% af %SLIDE_COUNT%</value><value xml:lang="fi">Dia %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="th">สไลด์ %CURRENT_SLIDE_NUMBER% จาก %SLIDE_COUNT%</value><value xml:lang="ms">Slaid %CURRENT_SLIDE_NUMBER% daripada %SLIDE_COUNT%</value><value xml:lang="fil">Slide %CURRENT_SLIDE_NUMBER% sa %SLIDE_COUNT%</value><value xml:lang="bn">স্লাইড %CURRENT_SLIDE_NUMBER% এর %SLIDE_COUNT%</value><value xml:lang="ta">ஸ்லைடு %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="te">స్లయిడ్ %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="mr">स्लाइड %CURRENT_SLIDE_NUMBER% पैकी %SLIDE_COUNT%</value><value xml:lang="sk">Snímka %CURRENT_SLIDE_NUMBER% z %SLIDE_COUNT%</value><value xml:lang="bg">Слайд %CURRENT_SLIDE_NUMBER% от %SLIDE_COUNT%</value><value xml:lang="hr">Slajd %CURRENT_SLIDE_NUMBER% od %SLIDE_COUNT%</value><value xml:lang="sr">Слајд %CURRENT_SLIDE_NUMBER% од %SLIDE_COUNT%</value><value xml:lang="sl">Diapozitiv %CURRENT_SLIDE_NUMBER% od %SLIDE_COUNT%</value><value xml:lang="lt">Skaidrė %CURRENT_SLIDE_NUMBER% iš %SLIDE_COUNT%</value><value xml:lang="lv">Slaids %CURRENT_SLIDE_NUMBER% no %SLIDE_COUNT%</value><value xml:lang="et">Slaid %CURRENT_SLIDE_NUMBER% / %SLIDE_COUNT%</value><value xml:lang="ca">Diapositiva %CURRENT_SLIDE_NUMBER% de %SLIDE_COUNT%</value></prop>
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>14</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>BBBBBC</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
        </node>
      </node>
      <node oor:name="TimeBar" oor:op="replace">
        <node oor:name="Entries">
          <node oor:name="a" oor:op="replace">
            <prop oor:name="Type"><value>PresentationTimeLabel</value></prop>
            <node oor:name="Normal">
              <node oor:name="Font"><prop oor:name="FamilyName"><value>Albert Sans</value></prop><prop oor:name="Size"><value>26</value></prop><prop oor:name="Style"><value></value></prop><prop oor:name="Color"><value>FFFFFF</value></prop><prop oor:name="Anchor"><value>Center</value></prop></node>
            </node>
          </node>
          <node oor:name="b" oor:op="replace">

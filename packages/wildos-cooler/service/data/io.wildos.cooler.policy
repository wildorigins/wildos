<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Wild OS</vendor>
  <vendor_url>https://wildos.io</vendor_url>
  <action id="io.wildos.cooler.control">
    <description>Change the cooler's screen, pump and fan speeds</description>
    <message>Cooler wants to change this PC's cooler</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>

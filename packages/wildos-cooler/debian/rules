#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -Wno-dev -DCMAKE_BUILD_TYPE=Release

# The tool that renders a face to a picture is for work on the faces, not
# for every PC.
execute_after_dh_auto_install:
	rm -f debian/wildos-cooler/usr/bin/wildos-cooler-face-render

# wildos-coolerd is started by udev when a cooler is there and by the bus
# when Cooler asks, never by being installed: most PCs have no such cooler.
# The postinst restarts one that is running.
override_dh_installsystemd:
	dh_installsystemd --no-start

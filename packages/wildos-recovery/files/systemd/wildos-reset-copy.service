[Unit]
Description=Keep the reset copy at the newest Wild OS release
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/run/initramfs/live

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# Copying a 2 GB release fills the page cache; past this the kernel
# reclaims the copy's own cache instead of the apps you are using.
MemoryHigh=768M
ExecStart=/usr/libexec/wildos/reset-copy update
